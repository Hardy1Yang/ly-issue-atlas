/ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/81/LCIDC01_1118105.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118105_00007/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"421-434","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"bdaa9de62a2b85d44031e33fb8d876a04b3aebe519e0f83647424f342b83d5f2"}],"highlights":{}},{"event_id":"speech:3e933c77393f3ce3","kind":"speech","activity":"speech","role":"speaker","date":"2022-09-16","date_start":"2022-09-16","date_end":"2022-09-16","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.36389540730807907,"housing":0.03402614817298022,"law_crime":0.34258017655603973,"government":0.13501508548441166,"civil_rights":0.06224159123924461,"technology":0.06224159123924461},"citation_count":102,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/86/LCIDC01_1118601.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118601_00011/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"391-414","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"e575c01652d7828e18898696ae902e307e48641a7038e510920452fcabcf05ae"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/86/LCIDC01_1118601.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118601_00011/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"391-414","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"e575c01652d7828e18898696ae902e307e48641a7038e510920452fcabcf05ae"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/86/LCIDC01_1118601.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118601_00011/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"391-414","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"e575c01652d7828e18898696ae902e307e48641a7038e510920452fcabcf05ae"}],"highlights":{"housing":{"excerpt":"選舉一到，我知道時代力量就搞這一條，居住正義已經講了5、6年，每次都說居住正義，這個我們都了解，但不要天天都在打那個議題，要回歸理性，這樣時代力量才會長大，我就講白一點。","terms":["居住正義"],"cut":[false,false],"hits":2,"citation":2},"law_crime":{"excerpt":"很高興在這裡又再次碰面了，我們馬上又有很長的時間在一起，開議以後是選舉會期，立法院會比較熱鬧一點，但是無論如何，我們有責任把立法院的程序儘量談妥，讓立法院早日能夠開議、順利進行，因為我們有很多法定的事情必須處理。","terms":["法院"],"cut":[false,false],"hits":3,"citation":0},"government":{"excerpt":"今年中間有一個選舉，因選舉會有一些專案報告，我們都尊重，是不是可以這樣安排？","terms":["選舉"],"cut":[false,false],"hits":2,"citation":null},"civil_rights":{"excerpt":"剛才說的包括氣候變遷因應法、精神衛生法，以及有關性隱私的4個相關法案如刑法、性剝削、性侵害及犯罪被害人保護法，都送出委員會了，那些法案要處理的話，開議以後我們就邊協商，沒差別啦！","terms":["隱私","性侵害"],"cut":[false,false],"hits":2,"citation":1},"technology":{"excerpt":"回到實際面，何時要處理，可以有秩序地安排，包括剛才民眾黨所談的，數發部的部分在上個會期已經處理過了，司法及法制等兩個委員會審查，連數發部成立的目的、功能等等都詢問過了，數發部的整體預算占總預算不到1%，其功能很重要，我們都承認。","terms":["數發部"],"cut":[false,false],"hits":3,"citation":1}}},{"event_id":"speech:dc5bb88b46e0d0a2","kind":"speech","activity":"speech","role":"speaker","date":"2022-09-20","date_start":"2022-09-20","date_end":"2022-09-20","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.20064377682403434,"technology":0.41058655221745344,"transportation":0.12875536480686695,"law_crime":0.2600143061516452},"citation_count":18,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/86/LCIDC01_1118601.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118601_00012/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"415-424","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"2a86d2a761d3280d36acc5de2ac543ba99b4e1acb5f2106c98f97bdb6592f505"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/86/LCIDC01_1118601.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118601_00012/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"415-424","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"2a86d2a761d3280d36acc5de2ac543ba99b4e1acb5f2106c98f97bdb6592f505"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/86/LCIDC01_1118601.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118601_00012/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"415-424","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"2a86d2a761d3280d36acc5de2ac543ba99b4e1acb5f2106c98f97bdb6592f505"}],"highlights":{"technology":{"excerpt":"謝委員衣鳯也說錯了，說什麼第一條就是數位產業發展，沒有這一條，開宗明義當然沒有錯，陳椒華委員講得很清楚，第一條是「行政院為促進全國通訊、資訊、資通安全、網路與傳播等數位產業發展……」，剛才邱臣遠委員所談的就是交通部應該予以建設，這是傳統的，","terms":["數位","通訊","資通","網路"],"cut":[false,true],"hits":11,"citation":0},"transportation":{"excerpt":"國通訊、資訊、資通安全、網路與傳播等數位產業發展……」，剛才邱臣遠委員所談的就是交通部應該予以建設，這是傳統的，所以網路建設NII等是比較重要的，交通部主要是在建設，整個網路建設，NII以及資安安全是未來國家最重要的一塊，當然郵電司有一些類","terms":["交通部","交通"],"cut":[true,true],"hits":5,"citation":0},"law_crime":{"excerpt":"第二個關於數發部在審查的時候，當然所有的組織法都是由司法委員會主審，然後和交通委員會一起聯席審查，有的國發會，有的科技部，國科會就是由司法及法制跟教育來聯席審查。","terms":["司法"],"cut":[false,false],"hits":2,"citation":1}}},{"event_id":"speech:d185d86a106c4796","kind":"speech","activity":"speech","role":"speaker","date":"2022-09-29","date_start":"2022-09-29","date_end":"2022-09-29","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.5457892314772206,"defense":0.05994017487344685,"law_crime":0.3300736309249885,"transportation":0.06419696272434422},"citation_count":63,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/87/LCIDC01_1118701.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118701_00016/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"511-534","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"cd2e1bfa505c644ce49e8c02f1a264a11d74b37b80abd001291618589930ccf6"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/87/LCIDC01_1118701.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118701_00016/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"511-534","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"cd2e1bfa505c644ce49e8c02f1a264a11d74b37b80abd001291618589930ccf6"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/87/LCIDC01_1118701.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118701_00016/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"511-534","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"cd2e1bfa505c644ce49e8c02f1a264a11d74b37b80abd001291618589930ccf6"}],"highlights":{"defense":{"excerpt":"第一個，以致命性武器、危害物品或交通工具攻擊、傷害、挾持、脅迫警察人員的時候，沒有辦法警察只好開槍了。","terms":["武器"],"cut":[false,false],"hits":1,"citation":0},"law_crime":{"excerpt":"有關警察執行勤務時，認為犯罪嫌疑人或行為人有下列行為時，將危及到警察人員或他人的生命安全，得使用槍械逕行射擊。","terms":["警察","犯罪"],"cut":[false,false],"hits":3,"citation":0},"transportation":{"excerpt":"版本的條文現在修正情形怎麼樣，第一個先談時代力量的版本，警械使用條例是從第一條、第二條、第三條，還有比例原則等等一直規範下來，包括警棍什麼時候使用、指揮交通的時候使用，第三條是規定在緊急情況時使用警棍，第二條是規定在指揮交通的時候使用警棍。","terms":["交通"],"cut":[true,false],"hits":2,"citation":1}}},{"event_id":"speech:2422b0e5308a1cb6","kind":"speech","activity":"speech","role":"speaker","date":"2022-10-12","date_start":"2022-10-12","date_end":"2022-10-12","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.4218600191754553,"government":0.3976510067114094,"law_crime":0.1804889741131352},"citation_count":33,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/88/LCIDC01_1118801.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118801_00013/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"517-524","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"1e31b48c0007e2ba8775dcf6b7887de9bd6f4ba53ddbf637834655822f895248"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/88/LCIDC01_1118801.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118801_00013/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"517-524","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"1e31b48c0007e2ba8775dcf6b7887de9bd6f4ba53ddbf637834655822f895248"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/111/88/LCIDC01_1118801.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1118801_00013/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"517-524","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"1e31b48c0007e2ba8775dcf6b7887de9bd6f4ba53ddbf637834655822f895248"}],"highlights":{"government":{"excerpt":"2005年時修憲時，立法院是擔任正方，我們修的是單一選區兩票制，那時候還有國大，不過是任務型國大，所以那時候是由立法院擔任正方，派立法院副院長鍾榮吉到國大去說明，然後由國大去複決，而這一次則是史無前例的。","terms":["修憲","複決"],"cut":[false,false],"hits":2,"citation":0},"law_crime":{"excerpt":"2005年時修憲時，立法院是擔任正方，我們修的是單一選區兩票制，那時候還有國大，不過是任務型國大，所以那時候是由立法院擔任正方，派立法院副院長鍾榮吉到國大去說明，然後由國大去複決，而這一次則是史無前例的。","terms":["法院"],"cut":[false,false],"hits":3,"citation":0}}},{"event_id":"speech:a70815fc08e6fce9","kind":"speech","activity":"speech","role":"speaker","date":"2022-12-15","date_start":"2022-12-15","date_end":"2022-12-15","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.7658730158730154,"government":0.1544973544973545,"education":0.07962962962962963},"citation_count":91,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/01/LCIDC01_1120104.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1120104_00011/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"383-410","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"eac9eaeffd81f637b0acc1f6fe841ce1864ce589249e784c11a973718f86e2ed"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/01/LCIDC01_1120104.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1120104_00011/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"383-410","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"eac9eaeffd81f637b0acc1f6fe841ce1864ce589249e784c11a973718f86e2ed"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/01/LCIDC01_1120104.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1120104_00011/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"383-410","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"eac9eaeffd81f637b0acc1f6fe841ce1864ce589249e784c11a973718f86e2ed"}],"highlights":{"government":{"excerpt":"在第二項，你把機關代表都拿掉，第二項沒有機關代表，只有公務人員代表及公務人員推薦之學者，機關代表全部沒有啊！","terms":["公務人員"],"cut":[false,false],"hits":2,"citation":0},"education":{"excerpt":"都是同樣一個來源，大家都是表演給電視看的，那是不可行的，不可能政府現在在負責改為財團法人來負責，財團法人將來不受貪污治罪條例約束，所以不可能越改越鬆落到私校的模式，私校它沒有辦法，那是私人的，所以它找一個財團法人，但是到最後還是都委託出去。","terms":["私校"],"cut":[true,false],"hits":2,"citation":1}}},{"event_id":"speech:726a20f9754c2545","kind":"speech","activity":"speech","role":"speaker","date":"2022-12-22","date_start":"2022-12-22","date_end":"2022-12-22","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.7902990517870168,"health":0.08169219547775347,"law_crime":0.08169219547775347,"transportation":0.04631655725747629},"citation_count":66,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/06/LCIDC01_1120603.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1120603_00009/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"273-286","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"d9f7ca6a262c6b2ea8239103500e486908ad32e1a021ae31effe97348fc77bbc"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/06/LCIDC01_1120603.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1120603_00009/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"273-286","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"d9f7ca6a262c6b2ea8239103500e486908ad32e1a021ae31effe97348fc77bbc"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/06/LCIDC01_1120603.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1120603_00009/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"273-286","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"d9f7ca6a262c6b2ea8239103500e486908ad32e1a021ae31effe97348fc77bbc"}],"highlights":{"health":{"excerpt":"我知道醫事人員……","terms":["醫事"],"cut":[false,false],"hits":1,"citation":2},"law_crime":{"excerpt":"我們接下來談法案，包括性私密影像有五個法案，剛剛法務部有進來，這5個法─刑法、刑施、性侵、性剝削、犯罪被害人保護法，坦白講這5個法我們列為優先法案，所以我們把它排到第一個要協商的法案。","terms":["法務部","刑法","犯罪"],"cut":[false,false],"hits":3,"citation":0},"transportation":{"excerpt":"另外，總預算有關內政及交通的部分，都是在國民黨手上，都是安排下禮拜三要處理，內政的召委是林文瑞委員，交通的召委是魯明哲委員，請他們下禮拜三處理完畢，接著送審查報告，到下禮拜五即12月30日那一天在院會宣讀。","terms":["交通"],"cut":[false,false],"hits":2,"citation":1}}},{"event_id":"speech:4f5869d40e7291bf","kind":"speech","activity":"speech","role":"speaker","date":"2023-01-16","date_start":"2023-01-16","date_end":"2023-01-16","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.857838795394154,"culture":0.04495128432240921,"macroeconomy":0.09720992028343667},"citation_count":62,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/20/LCIDC01_1122005.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122005_00009/parsed","verification_status":"third_party_transcript_unverified","prin