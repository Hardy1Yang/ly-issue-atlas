ing_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.38685043769789523,"government":0.24445893089960885,"law_crime":0.3053641273980257,"health":0.06332650400447011},"citation_count":66,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/21/LCIDC01_1122101.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122101_00012/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"409-424","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"86c5eec4aea0fee98394561008d354751dab09811fe5a1d2e21cd992ef2a20fb"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/21/LCIDC01_1122101.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122101_00012/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"409-424","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"86c5eec4aea0fee98394561008d354751dab09811fe5a1d2e21cd992ef2a20fb"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/21/LCIDC01_1122101.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122101_00012/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"409-424","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"86c5eec4aea0fee98394561008d354751dab09811fe5a1d2e21cd992ef2a20fb"}],"highlights":{"government":{"excerpt":"一點，立法院職權行使法修了之後到目前為止，朝野協商之所以能夠處理所有事情就是因為大法官釋字第342號，否則國會沒有辦法運轉，大法官在解釋的時候是澈底針對國會制度，只要你不違憲、不違背法律條文的規定，只要有共識就可以了，至於憲法以後要不要修我","terms":["大法官","憲法"],"cut":[true,true],"hits":3,"citation":0},"law_crime":{"excerpt":"邱顯智呀，我想你不要咬著這一點，立法院職權行使法修了之後到目前為止，朝野協商之所以能夠處理所有事情就是因為大法官釋字第342號，否則國會沒有辦法運轉，大法官在解釋的時候是澈底針對國會制度，只要你不違憲、不違背法律條文的規定，只要有共識就可以","terms":["法院","法官"],"cut":[false,true],"hits":4,"citation":0},"health":{"excerpt":"大家先表態，你們的版本跟他們長得不一樣，你們的版本跟我們比較靠近，邱顯智委員、行政院的版本也跟我們比較靠近，都有第三條、也有勞健保，你最在意勞健保嘛！","terms":["健保"],"cut":[false,false],"hits":2,"citation":1}}},{"event_id":"speech:c2bf4e4cdf492480","kind":"speech","activity":"speech","role":"speaker","date":"2023-02-20","date_start":"2023-02-20","date_end":"2023-02-20","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"民主進步黨","dedup_status":"unresolved","topics":{"unclassified":0.5238866396761134,"health":0.1617633828160144,"labor":0.07269455690508322,"social_welfare":0.07269455690508322,"culture":0.0844804318488529,"macroeconomy":0.0844804318488529},"citation_count":93,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/21/LCIDC01_1122101.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122101_00014/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"443-468","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"03dc864a3c2dec505f8ae3f26c42a05b72b90c95424836207d1f69cd3e462365"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/21/LCIDC01_1122101.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122101_00014/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"443-468","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"03dc864a3c2dec505f8ae3f26c42a05b72b90c95424836207d1f69cd3e462365"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/21/LCIDC01_1122101.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1122101_00014/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"443-468","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"03dc864a3c2dec505f8ae3f26c42a05b72b90c95424836207d1f69cd3e462365"}],"highlights":{"health":{"excerpt":"至於開頭部分，我們講的當然就是「為因應……疫情全球經濟挑戰」，你說的是「對經濟生活的衝擊」，其實差不多一樣，沒有什麼差別。","terms":["疫情"],"cut":[false,false],"hits":1,"citation":2},"labor":{"excerpt":"我認為國民黨的部分比較窄化，只提到勞保與健保，而民進黨並沒有修正，所以可否採納行政院版本第一條內容？","terms":["勞保"],"cut":[false,false],"hits":1,"citation":2},"social_welfare":{"excerpt":"上個禮拜才提出的版本……版本和我們的一樣，只是沒有其他的部分而已，有修正，修正之餘，你剛才再提一個撥補公共年金，可是你這樣講，我看你的第四條也沒有任何預算，也是空的，只有1,000億及500億元，第四條對於撥補公共年金沒有做任何預算的安排。","terms":["年金"],"cut":[true,false],"hits":2,"citation":0},"culture":{"excerpt":"後來我們第三條條文有重新調整過，在調整過以後我們增加一款有關減輕就學學貸部分的負擔，另外還有擴大藝文消費及振興藝文產業這部分，等一下進入第三條的時候我們再請相關部會詳細說明，這是經過協商以後第三條我們認為可以調整的部分，免得被說是空白授權。","terms":["藝文"],"cut":[true,false],"hits":2,"citation":1},"macroeconomy":{"excerpt":"至於有關排除公債法第五條第七項的部分，我們認為不必了，因為本來就不會超過公債法第五條第七項百分之十五的限制，這些部分我們可以，流量的部分是百分之十五。","terms":["公債"],"cut":[false,false],"hits":2,"citation":1}}},{"event_id":"bill:202103121060000","kind":"bill_proposal","activity":"bill_cosign","role":"cosigner","date":"2023-03-10","date_start":"2023-03-10","date_end":"2023-03-10","meeting_id":"院會-10-7-3","meeting":"第10屆第7會期第3次會議","bill_id":"202103121060000","title":"「立法院組織法部分條文修正草案」，請審議案。","party":"民主進步黨","dedup_status":"cross_source","topics":{"international":0.5,"law_crime":0.5},"citation_count":2,"citations":[{"provider":"lyapi_v2","official_url":"https://ppg.ly.gov.tw/ppg/bills/202103121060000/details","link_kind":"bill_page","verification_status":"third_party_index","snapshot":"fb12ee870c3f6f31a492b543e8221fc4f1c3adfbc14239deaeb3e5d655a3c87f"}]},{"event_id":"speech:cb631d548a3d2340","kind":"speech","activity":"speech","role":"speaker","date":"2023-04-27","date_start":"2023-04-27","date_end":"2023-04-