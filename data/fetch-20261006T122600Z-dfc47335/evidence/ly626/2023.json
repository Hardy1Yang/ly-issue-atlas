7278be3f88b36fb5dd06cb20807364"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/62/LCIDC01_1126202.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1126202_00004/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"199-218","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"673fa55091f9d69faffe6908934015f7c97278be3f88b36fb5dd06cb20807364"},{"provider":"lyapi_v2","source":"lyapi_ivods","official_url":"https://ivod.ly.gov.tw/Play/Clip/1M/146885","link_kind":"ivod","source_url":"https://v2.ly.govapi.tw/ivods?%E5%B1%86=10&%E6%9C%83%E6%9C%9F=7&limit=1000&page=1","verification_status":"official_video_index_unreviewed","printed_pages":null,"pdf_page":null,"speaker_label":"柯建銘","snapshot":"fa35f8fdd54c24a03bc324b3740980d072b8312e30375cab404ef54ad242ce90"}],"highlights":{"law_crime":{"excerpt":"，其餘都沒有意見，包括「應先經徵詢國會意見」，我們都覺得這是應該有的作為，國會立法院和行政部門本來就必須密切的合作，而且要和社會展開溝通的過程，所以我們詢得曾銘宗委員的同意，認為國民黨江啟臣委員的提案只要把第二段最後一句話劃掉就可以了，以上","terms":["法院"],"cut":[true,true],"hits":1,"citation":0},"foreign_trade":{"excerpt":"今天我們在處理很重要的臺美21世紀貿易倡議，我想大家都基於國家立場、臺美關係，以及未來國家發展，不管是經濟貿易與勞工等問題都很關心，也都到現場來，現在處理的是5項，爾後還有7項，當然我們也知道美國國會的參、眾二院通過了這個授權法，對於國會尊","terms":["貿易"],"cut":[false,true],"hits":2,"citation":0},"macroeconomy":{"excerpt":"主席，等一下，有關於建請行政院參考美國，兩邊的系統不一樣，主計總處要進行那一套不是那麼簡單。","terms":["主計總處"],"cut":[false,false],"hits":1,"citation":1}}},{"event_id":"speech:c956bb9cd407003a","kind":"speech","activity":"speech","role":"speaker","date":null,"date_start":"2023-10-11","date_end":"2023-10-12","meeting_id":"委員會-10-8-35-4","meeting":"第10屆第8會期外交及國防委員會第4次全體委員會議","bill_id":null,"title":"第10屆第8會期外交及國防委員會第4次全體委員會議","party":"民主進步黨","dedup_status":"cross_source","topics":{"unclassified":0.29312169312169306,"defense":0.35343915343915344,"law_crime":0.35343915343915344},"citation_count":11,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/69/LCIDC01_1126901.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1126901_00006/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"375-468","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"9d98bf5f102bb8fca223269f43b901cac6b76cc5763cbde0ca136b075eb8e343"},{"provider":"lyapi_v2","source":"lyapi_ivods","official_url":"https://ivod.ly.gov.tw/Play/Clip/1M/147458","link_kind":"ivod","source_url":"https://v2.ly.govapi.tw/ivods?%E5%B1%86=10&%E6%9C%83%E6%9C%9F=8&limit=1000&page=2","verification_status":"official_video_index_unreviewed","printed_pages":null,"pdf_page":null,"speaker_label":"柯建銘","snapshot":"ac9b138691e39a839b857a0ebf7af53a3a562cbe0d6fccb5ddac9e76b49a976e"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/112/69/LCIDC01_1126901.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1126901_00006/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"375-468","pdf_page":null,"speaker_label":"柯委員建銘","snapshot":"9d98bf5f102bb8fca223269f43b901cac6b76cc5763cbde0ca136b075eb8e343"}],"highlights":{"defense":{"excerpt":"裡的時候正好，因為江啟臣委員剛剛有提案，爾後在協商的時候要不要、在院會表決要不要，我們現在只規範國防委員會，包括國安局、外交部以及僑委會這種秘密預算，今天是談國防委員會，那經濟委員會、其他委員會可能也有秘密的問題，所以將來要一視同仁來看待。","terms":["國防"],"cut":[true,false],"hits":2,"citation":0},"law_crime":{"excerpt":"我們都知道有國家機密保護法，這是上位的法律，接下來有立法院職權行使法，接下來有立法院議事規則，乃至於剛才江啟臣委員講的秘密會議注意事項，這是一套的，我們應該整個以這樣的package來看待，不要說因為抓住哪一點，然後互相攻擊、講不好聽的話，","terms":["法院"],"cut":[false,true],"hits":2,"citation":0}}},{"event_id":"speech:ec537bded902b271","kind":"speech","activity":"speech","role":"speaker","date":null,"date_start":"2023-12-08","date_end":"2023-12-12","meeting_id":"院會-10-8-11","meeting":"第10屆第8會期第11次會議","bil