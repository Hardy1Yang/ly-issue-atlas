240a52b57cb809daa51c9ef98bb5d33769"}]},{"event_id":"speech:51d5535cc6edd220","kind":"speech","activity":"speech","role":"speaker","date":"2025-02-25","date_start":"2025-02-25","date_end":"2025-02-25","meeting_id":null,"meeting":null,"bill_id":null,"title":null,"party":"台灣民眾黨","dedup_status":"unresolved","topics":{"unclassified":0.14353395332514476,"labor":0.07843481312510966,"social_welfare":0.18994560449201614,"education":0.12010879101596772,"civil_rights":0.05878224249868398,"commerce":0.11528338304965784,"culture":0.05878224249868398,"government":0.05878224249868398,"health":0.05878224249868398,"law_crime":0.05878224249868398,"technology":0.05878224249868398},"citation_count":12,"citations":[{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/24/LCIDC01_1142401.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1142401_00004/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"13-232","pdf_page":null,"speaker_label":"吳委員春城","snapshot":"1030befe2c360820ea477944dee3fff0d85c1361d192b186956b32d183c429e9"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/24/LCIDC01_1142401.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1142401_00004/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"13-232","pdf_page":null,"speaker_label":"吳委員春城","snapshot":"1030befe2c360820ea477944dee3fff0d85c1361d192b186956b32d183c429e9"},{"provider":"lyapi_v2","source":"lyapi_gazette_transcripts","official_url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/24/LCIDC01_1142401.pdf","link_kind":"gazette_pdf","source_url":"https://v2.ly.govapi.tw/gazette_agenda_doc/1142401_00004/parsed","verification_status":"third_party_transcript_unverified","printed_pages":"13-232","pdf_page":null,"speaker_label":"吳委員春城","snapshot":"1030befe2c360820ea477944dee3fff0d85c1361d192b186956b32d183c429e9"}],"highlights":{"labor":{"excerpt":"接下來，一年前勞動部率先以壯世代為名，制定了壯世代重返職場的計畫，這個計畫一年中創造了9.7萬筆的新聞，成為勞動部非常亮眼、受歡迎的政策。","terms":["勞動部","勞動","職場"],"cut":[false,false],"hits":5,"citation":0},"social_welfare":{"excerpt":"接下來還有問題，第二個讓我難過的是有人曲解壯促法企圖搶奪社福的資源，壯促法並非權益法，20條的條文都不涉及資源的分配，壯促法是為了避免龐大的高齡人口成為失能的人口土石流，才能保障照護性政策的永續性，所以壯促法在與現行的社福政策，如同車子雙軌","terms":["社福"],"cut":[false,true],"hits":2,"citation":2},"education":{"excerpt":"接下來，早在壯促法通過之前，去年12月教育部推出了第三人生大學的試辦計畫，有38所公私立的大學響應，請問院長會繼續支持第三人生大學的試辦計畫嗎？","terms":["教育部","教育","大學"],"cut":[false,false],"hits":5,"citation":1},"civil_rights":{"excerpt":"去年我到立法院嚇了一跳，發現許多政策在歧視高齡，45歲叫中高齡，65歲就是老人，行政院高齡科技產業只剩養生，滿75歲就可能被吊銷駕照，教育部終身教育司預算6億，平均每位高齡者一年的教育預算不到100塊，高齡者數位落差達到六成，滿65歲買個保","terms":["歧視"],"cut":[false,true],"hits":1,"citation":null},"commerce":{"excerpt":"當然還有很多的部會響應了壯世代，譬如數發部在去年11月資訊月推出了「壯世代懂資樂園」、懂資訊的樂園，創造了數萬名壯世代入場，而且金管會也大力推動金融去年齡歧視的一連串政策。","terms":["金管會","金融"],"cut":[false,false],"hits":2,"citation":null},"culture":{"excerpt":"並就各機關要求提出具體的工作計畫，包括衛福部、勞動部、金管會、教育部、文化部、經濟部都有更詳細的政策規劃，在去年11月6號，行政院提出完整的書面報告，行政院將壯世代專業小組擴充到14個部會的參與，提出了76項的工作計畫，所以壯促法源自行政院","terms":["文化部","文化"],"cut":[false,true],"hits":2,"citation":null},"government":{"excerpt":"關於參與標案的指控，本席擔任公職以後，原有二等親依法參與的政府公標案絕對遵守公職人員利益迴避，公開介入合法合規，所有的標案都是公開招標、合法得標，而且獲獎連連，但憑專業實力的競爭，無須特權的干預。","terms":["公職"],"cut":[false,false],"hits":2,"citation":null},"health":{"excerpt":"遍布全場，但隨著歌聲搖曳的手機螢光幕也不輸年輕人，他們就是壯世代，他們不是只需要長照、養生、養病、養老，他們已經超過了八百萬人，占臺灣人口的三分之一，我來立法院就是要為他們請命，他們需要教育政策、文化政策、數位政策、勞動政策、經濟、金融等等","terms":["長照"],"cut":[true,true],"hits":1,"citation":null},"law_crime":{"excerpt":"另一方面，要感謝的是多數立法院不分黨派的委員對壯世代的大力支持，進入立法院之初，我就非常的清楚推動壯世代一定要超越黨派共同推動，因為壯世代屬於全民，要避免政黨的對立。","terms":["法院"],"cut":[false,false],"hits":2,"citation":null},"technology":{"excerpt":"法院嚇了一跳，發現許多政策在歧視高齡，45歲叫中高齡，65歲就是老人，行政院高齡科技產業只剩養生，滿75歲就可能被吊銷駕照，教育部終身教育司預算6億，平均每位高齡者一年的教育預算不到100塊，高齡者數位落差達到六成，滿65歲買個保險、投資金","terms":["科技","數位"],"cut":[true,true],"hits":2,"citation":null}}},{"event_id":"speech:5f1397ea0600ed71","kind":"speech","activity":"speech","role":"speaker","date":"2025-02-25","date_start":"2025-02-25","date_end":"2025-02-25","meeting_id":"院會-11-3-2","meeting":"第11屆第3會期第2次會議","bill_id":null,"title":"第11屆第3會期第2次會議","party":"台灣民眾黨","dedup_status":"single_source","topics":{"unclassified":1.0},"citation_count":1,"citations":[{"provider":"lyapi_v2","source":"lyapi_ivods","official_url":"https://ivod.ly.gov.tw/Play/Clip/1M/158965","link_kind":"ivod","source_url":"https://v2.ly.govapi.tw/ivods?%E5%B1%86=11&%E6%9C%83%E6%9C%9F=3&limit=1000&page=6","verification_status":"official_video_index_unreviewed","printed_pages":null,"pdf_page":null,"speaker_label":"吳春城","snapshot":"ecf052e70d6ef74262f28545088b660ebc2dd4040d8f642edb8a8e3ffd2e201a"}],"highlights":{}}]}