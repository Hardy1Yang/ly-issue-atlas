ds=%E8%AD%B0%E6%A1%88%E7%8B%80%E6%85%8B&output_fields=%E8%AD%B0%E6%A1%88%E6%B5%81%E7%A8%8B&output_fields=%E6%A1%88%E7%94%B1&output_fields=%E5%AD%97%E8%99%9F&output_fields=%E6%8F%90%E6%A1%88%E7%B7%A8%E8%99%9F&output_fields=%E7%9B%B8%E9%97%9C%E9%99%84%E4%BB%B6&page=5","verification_status":"third_party_index","printed_pages":null,"pdf_page":null,"speaker_label":null,"snapshot":"02550c1d94fad24d5b0e2160001d94fc0c53be282ca637078dc690a98fdee2db"},{"provider":"ly_open_data","source":"official_bills_id20","official_url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/05/LCEWA01_110105_00128.pdf","link_kind":"bill_doc","source_url":"https://data.ly.gov.tw/odw/ID20Action.action?term=11&sessionPeriod=01&sessionTimes=&meetingTimes=&billName=&billOrg=&billProposer=&billCosignatory=&fileType=json","verification_status":"official_open_data","printed_pages":null,"pdf_page":null,"speaker_label":null,"snapshot":"b36d485e88315f15bd04cada91dbcbd04f6892e3a4a52b81b26c61320cff0fdf"}],"highlights":{"transportation":{"excerpt":"經查，交通部於民國76年辦理「臺灣西部走廊高速鐵路可行性研究」，79年奉行政院核定「臺灣南北高速鐵路建設計畫」，臺灣高速鐵路的籌建進入執行階段，而辦理方式也由政府逐年編列預算改為民間投資參與興建並於特許期限過後無償交還中華民國政府經營，台灣","terms":["交通部","交通","鐵路"],"cut":[false,true],"hits":7,"citation":null}},"summary":"本院委員傅崐萁、韓國瑜、江啟臣、洪孟楷、林思銘、徐欣瑩、鄭天財Sra Kacaw、蘇清泉等53人，有鑑於臺灣東部日益增加的城際運輸需求，高速鐵路建設發展將使城際間之距離拉近，環島高速鐵路將使臺灣從北到南、從西到東成為一日生活圈，將帶動地方經濟、產業、觀光的各項發展。臺灣島僅3.6萬平方公里，環島一周長度約939.5公里，臺灣已晉升已開發國家之列，完善的軌道建設環島高速鐵路網早晚須建設，近年通貨膨脹嚴重，許多建設「今天不做，明天就會後悔！」。經查，交通部於民國76年辦理「臺灣西部走廊高速鐵路可行性研究」，79年奉行政院核定「臺灣南北高速鐵路建設計畫」，臺灣高速鐵路的籌建進入執行階段，而辦理方式也由政府逐年編列預算改為民間投資參與興建並於特許期限過後無償交還中華民國政府經營，台灣高鐵於民國88年3月動工，並於95年12月24日完工通車，96年1月5日開始營運至112年為止，年運量高達7,308萬人次，平均每天高於20萬人次，時速最高300公里。使得高速鐵路成為臺灣城際運輸的新潮流。而台灣高鐵由最初建設的臺北、板橋、桃園、新竹、臺中、嘉義、臺南、左營等8站營運，因應地方發展需求104年陸續增設苗栗、彰化及雲林3站，105年又延伸至南港。108年9月27日，交通部拍板高鐵延伸到屏東六塊厝站；110年12月19日交通部再度定案高鐵延伸宜蘭新站共構，最快114年動工、125年完工。然臺灣島僅剩宜蘭至花蓮、花蓮至臺東及臺東至屏東之東部最後一哩路，即可完成環島高速鐵路，中央政府不應讓東、西部發展不均，應更重視花東地區鄉親行的安全及權益，爰擬具「環島高速鐵路建設特別條例草案」，期由政府主導，完善建構花東地區全面性公共大眾運輸交通建設，建構全臺一日生活圈，以彌補區域發展不均之問題。是否有當？敬請公決。","summary_truncated":false},{"event_id":"bill:202110014420000","kind":"bill_proposal","activity":"bill_primary","role":"proposer","date":"2024-03-15","date_start":"2024-03-15","date_end":"2024-03-15","meeting_id":"院會-11-1-5","meeting":"第11屆第1會期第5次會議","bill_id":"202110014420000","title":"「國道六號東延花蓮建設特別條例草案」，請審議案。","party":"中國國民黨","dedup_status":"cross_source","topics":{"transportation":1.0},"citation_count":2,"citations":[{"provider":"lyapi_v2","source":"lyapi_bills","official_url":"https://ppg.ly.gov.tw/ppg/bills/202110014420000/details","link_kind":"bill_page","source_url":"https://v2.ly.govapi.tw/bills?%E5%B1%86=11&%E6%9C%83%E6%9C%9F=1&limit=1000&output_fields=%E8%AD%B0%E6%A1%88%E7%B7%A8%E8%99%9F&output_fields=%E6%8F%90%E6%A1%88%E6%97%A5%E6%9C%9F&output_fields=%E8%AD%B0%E6%A1%88%E9%A1%9E%E5%88%A5&output_fields=%E6%8F%90%E6%A1%88%E4%BE%86%E6%BA%90&output_fields=%E6%8F%90%E6%A1%88%E5%96%AE%E4%BD%8D%2F%E6%8F%90%E6%A1%88%E5%A7%94%E5%93%A1&output_fields=%E6%8F%90%E6%A1%88%E4%BA%BA&output_fields=%E9%80%A3%E7%BD%B2%E4%BA%BA&output_fields=%E6%B3%95%E5%BE%8B%E7%B7%A8%E8%99%9F&output_fields=%E6%9C%83%E8%AD%B0%E4%BB%A3%E7%A2%BC&output_fields=%E8%AD%B0%E6%A1%88%E5%90%8D%E7%A8%B1&output_fields=%E8%AD%B0%E6%A1%88%E7%8B%80%E6%85%8B&output_fields=%E8%AD%B0%E6%A1%88%E6%B5%81%E7%A8%8B&output_fields=%E6%A1%88%E7%94%B1&output_fields=%E5%AD%97%E8%99%9F&output_fields=%E6%8F%90%E6%A1%88%E7%B7%A8%E8%99%9F&output_fields=%E7%9B%B8%E9%97%9C%E9%99%84%E4%BB%B6&page=5","verification_status":"third_party_index","printed_pages":null,"pdf_page":null,"speaker_label":null,"snapshot":"02550c1d94fad24d5b0e2160001d94fc0c53be282ca637078dc690a98fdee2db"},{"provider":"ly_open_data","source":"official_bills_id20","official_url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/05/LCEWA01_110105_00129.pdf","link_kind":"bill_doc","source_url":"https://data.ly.gov.tw/odw/ID20Action.action?term=11&sessionPeriod=01&sessionTimes=&meetingTimes=&billName=&billOrg=&billProposer=&billCosignatory=&fileType=json","verification_status":"official_open_data","printed_pages":null,"pdf_page":null,"speaker_label":null,"snapshot":"b36d485e88315f15bd04cada91dbcbd04f6892e3a4a52b81b26c61320cff0fdf"}],"highlights":{"transportation":{"excerpt":"另外，中央政府於1986年時，規劃由臺灣省政府公路局開始辦理中橫快速公路可行性研究（埔里─花蓮），並於1990年3月完成可行性研究報告，1991年8月交通部函示將本計畫自埔里延伸至草屯，以銜接國道三號，1994年交通部召開「研商12項建設規","terms":["公路","交通部","交通","國道"],"cut":[false,true],"hits":10,"citation":null}},"summary":"本院委員傅崐萁、韓國瑜、江啟臣、洪孟楷、林思銘、鄭天財Sra Kacaw、蘇清泉等53人，有鑑於臺灣本島地形狹長，由中央山脈及雪山山脈分隔為東西部地區，導致臺中至花蓮交通須繞本島一半方可連通，造成兩地居民交流困難，因此政府於1956年7月7日興建中部橫貫公路，於1960年5月9日通車，然該公路因1999年九二一大地震後長期封閉中橫公路上谷關至德基路段，直至2018年11月16日才再開放公車行駛，預計到2023年至2025年，才有可能進行全線復建或開通行駛。歷經中部橫貫公路長年因天候坍方、中斷，足見中部橫貫公路已無法維持長期穩定的安全度！政府應積極推動現有國道六號延伸至之建設，以利中部居民往返東部地區之便利。另外，中央政府於1986年時，規劃由臺灣省政府公路局開始辦理中橫快速公路可行性研究（埔里─花蓮），並於1990年3月完成可行性研究報告，1991年8月交通部函示將本計畫自埔里延伸至草屯，以銜接國道三號，1994年交通部召開「研商12項建設規劃中部橫貫公路會議」，指示接續辦理第二階段可行性研究，行政院1999年1月核復分為兩段辦理，其一即評估因為埔里至花蓮段尚存地熱、斷層、岩爆、湧水等不確定因素，要求交通部繼續評估後另案陳報核定，直至今日，埔里至花蓮段仍停留在評估階段，未被核准辦理。隨著時間的推移，現今工程技術已大幅進步，過去的困難已能逐各突破，埔里至花蓮段亦有極高之可行性，並可有效連結東西部交通及中、東部兩地居民交流更加方便，且可落實花東居民之交通平權，爰擬具「國道六號東延花蓮建設特別條例草案」，期由政府主導，完善建構橫貫東西交通公共交通建設，以彌補區域發展不均之問題。是否有當？敬請公決。","summary_truncated":false}]}