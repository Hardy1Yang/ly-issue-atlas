"bills":86},{"year":2023,"stage":"flow_unknown","as_of":"2024-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":86}],"records":{"civil_rights":[{"person_id":"ly1254","year":2023,"event_id":"bill:202103111570000","activity":"bill_primary","title":"「中央行政機關組織基準法第三十二條條文修正草案」，請審議案。","meeting":"第10屆第7會期第1次會議","date":"2023-02-17","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於我國個人資料保護法目前由國家發展委員會轄下之個人資料保護專案辦公室專責，然而近期發生公務部門戶政資料外洩及公務人員長期違法查詢民眾健保個資疑慮，卻無相對之第三方獨立機關進行監理，遏止不當行為發生，並也無法調查案件發","terms":["個人資料","個資"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103111570000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/01/LCEWA01_100701_00031.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103182050000","activity":"bill_primary","title":"「性別平等教育法修正草案」，請審議案。","meeting":"第10屆第7會期第2次臨時會第1次會議","date":"2023-07-17","highlight":{"excerpt":"本院台灣民眾黨黨團，因近期性騷擾事件頻傳，為建立更友善、有效及可信賴之制度，並考量軍事學校、預備學校、警察各級學校及少年矯正學校亦有適用本法之需求，又因應教師法修正及各界均有相關修法建議，解決學校面對校園性侵害、性騷擾或性霸凌事件之通報、調","terms":["性騷擾","性侵害"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103182050000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/03/pdf/10/07/02/01/LCEWA01_10070201_00021.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103116320000","activity":"bill_primary","title":"「個人資料保護法修正草案」，請審議案。","meeting":"第10屆第7會期第2次會議","date":"2023-03-03","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於近來個資外洩事件頻傳及個資法修法逾10年期間，團體訴訟至今無成功案例，致使民眾個資權益保障無法落實，又資料經濟時代來臨，個人隱私權保障及資料自主權更形重要，故參照歐盟《一般資料保護規範》賦予民眾資料自主相關權利，並","terms":["個資","隱私"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103116320000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/02/LCEWA01_100702_00