","url":"https://ppg.ly.gov.tw/ppg/bills/202103111550000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/01/LCEWA01_100701_00029.pdf","printed_pages":null}]}],"law_crime":[{"person_id":"ly1254","year":2023,"event_id":"bill:202103111600000","activity":"bill_primary","title":"「軍事審判法第十一條條文修正草案」，請審議案。","meeting":"第10屆第7會期第1次會議","date":"2023-02-17","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於102年軍事審判法修正後，現役軍人非戰時犯罪案件已全部改由普通法院審理，相關偵審工作不再由軍法系統處理，考試院即停辦軍法官考試，迄今已逾8年未舉辦軍法官考試，導致尉級與少校級軍法官人力缺口逐漸擴大，雖國防部訂於112","terms":["審判","犯罪","法院","審理","法官"],"cut":[false,true]},"hits":12,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103111600000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/01/LCEWA01_100701_00035.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103135340000","activity":"bill_primary","title":"「洗錢防制法增訂第十四條之一條文草案」，請審議案。","meeting":"第10屆第7會期第6次會議","date":"2023-04-07","highlight":{"excerpt":"實務上詐欺犯罪往往擴及至洗錢犯罪，而申辦或買賣人頭帳戶為實行洗錢行為之主要工具，為遏止詐欺犯罪持續增加，爰參採日本《犯罪收益移轉防止法》擬具「洗錢防制法增訂第十四條之一條文草案」。","terms":["詐欺","犯罪"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103135340000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/06/LCEWA01_100706_00065.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103223750000","activity":"bill_primary","title":"「刑事訴訟法第二百零五條之二條文修正草案」，請審議案。","meeting":"第10屆第8會期第4次會議","date":"2023-10-20","highlight":{"excerpt":"本院台灣民眾黨黨團，鑒於司法院憲法法庭111年憲判字第16號判決要旨，已宣告刑事訴訟法第二百零五條之二為違憲，爰擬具「刑事訴訟法第二百零五條之二條文修正草案」。","terms":["司法","法院","判決","刑事"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103223750000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/08/04/LCEWA01_100804_00053.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103152390000","activity":"bill_primary","title":"「人口販運防制法部分條文修正草案」，請審議案。","meeting":"第10屆第7會期第10次會議","date":"2023-05-05","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於人口販運罪是國際社會公認惡性重大且嚴重殘害人權之犯罪行為，近期發生國人遭詐騙至境外遭拘禁而不得不從事勞動性質之犯罪活動頻傳，實有與時俱進修正之必要；另為深化人口販運被害人權益保障，並為強化政府採購與人權治理之連結，","terms":["犯罪","詐騙"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103152390000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/10/LCEWA01_100710_00068.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103111620000","activity":"bill_primary","title":"「毒品危害防制條例第九條條文修正草案」，請審議案。","meeting":"第10屆第7會期第1次會議","date":"2023-02-17","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於新興毒品氾濫，持有、吸食及販賣毒品案件的在學學生人數逐年遞增，毒品不僅嚴重危害青少年之健全心智成長與身體健康，更間接造成社會成本上升，另有心人士亦瞄準年輕學子天性純真、好奇心重之弱點，利用毒品控制，滲透學校；根據教育","terms":["毒品"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103111620000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/07/01/LCEWA01_100701_00033.pdf","printed_pages":null}]}],"unclassified":[{"person_id":"ly1254","year":2023,"event_id":"bill:202103235140000","activity":"bill_primary","title":"「槍砲彈藥刀械管制條例第四條及第五條之三條文修正草案」，請審議案。","meeting":"第10屆第8會期第11次會議","date":"2023-12-08","highlight":null,"hits":0,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202103235140000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/08/11/LCEWA01_100811_00041.pdf","printed_pages":null}]},{"person_id":"ly1254","year":2023,"event_id":"bill:202103229310000","activity":"bill_primary","title":"「社會秩序維護法第七十二條條文修正草案」，請審議案。","meeting":"第10屆第8會期第6次會議","date":"2023-11-03","highlight":null,"hits":0,"links":[{"kind":"bill_pa