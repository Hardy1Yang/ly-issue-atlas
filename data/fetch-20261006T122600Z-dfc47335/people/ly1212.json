f","printed_pages":"1-72"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/108/89/LCIDC01_1088902.pdf","printed_pages":"1-72"}]}]}}