12110110810000/details","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110157300000","activity":"bill_primary","title":"「公民投票法第二十三條條文修正草案」，請審議案。","meeting":"第11屆第3會期第27次會議","date":"2025-08-29","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於現行公民投票之舉行，與全國性選舉脫鉤，嚴重阻礙人民行使直接民權，為打破鳥籠公投，實踐憲法主權在民之原則，爰擬具「公民投票法第二十三條條文修正草案」，明定主管機關應於公民投票案公告成立後一個月起至六個月內舉行公民投票","terms":["選舉","公投","憲法"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110157300000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/10/LCEWA01_110410_00189.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110155860000","activity":"bill_primary","title":"「刑事訴訟法第九十三條及第一百零一條條文修正草案」，請審議案。","meeting":"第11屆第3會期第26次會議","date":"2025-08-22","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於司法院大法官釋字第六六五號解釋理由書已指出，羈押係干預身體自由最大之強制處分，僅能以之為保全程序之最後手段，惟實務上，「勾串共犯或證人」之羈押事由已遭嚴重濫用，法院更屢以例稿及空泛模糊理由裁定羈押被告，違反憲法法庭","terms":["大法官","憲法"],"cut":[false,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110155860000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/26/LCEWA01_110326_00026.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110123830000","activity":"bill_primary","title":"「國家安全法第七條、第八條及第八條之一條文修正草案」，請審議案。","meeting":"第11屆第3會期第11次會議","date":"2025-05-09","highlight":{"excerpt":"此外，現行公務人員或機關首長違反公務人員任用法第四條第二項所定辦法，未函請法務部調查局辦理公務人員之特殊查核，竟未有任何處罰，實為國家安全重大漏洞。","terms":["公務人員"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110123830000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/11/LCEWA01_110311_00057.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110116610000","activity":"bill_primary","title":"「道路交通管理處罰條例第三十五條條文修正草案」，請審議案。","meeting":"第11屆第3會期第10次會議","date":"2025-05-02","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於憲法法庭一百十一年憲判字第一號判決指出，現行道路交通管理處罰條例第三十五條第六項牴觸憲法第八條保障人身自由及第二十二條保障身體權及資訊隱私權之意旨，爰擬具「道路交通管理處罰條例第三十五條條文修正草案」，就血液酒精濃","terms":["憲法"],"cut":[false,true]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110116610000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/10/LCEWA01_110310_00059.pdf","printed_pages":null}]}],"health":[{"person_id":"ly1284","year":2024,"event_id":"bill:202110034790000","activity":"bill_primary","title":"「再生醫療法草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"再者，再生醫療為嶄新、複雜、又需高額花費的醫療科技領域，任何單一專業都孤掌難鳴，難以成就再生醫療之大事，此法應依據醫師、藥師、生醫、化學、醫工等各領域人員之專業進行分工，惟其生醫療領域龐大，可再約略區分為細胞治療、基因治療與組織工程三個子領","terms":["醫療","醫師","治療"],"cut":[false,true]},"hits":13,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034790000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00170.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110068750000","activity":"bill_primary","title":"「醫學工程師法草案」，請審議案。","meeting":"第11屆第2會期第3次會議","date":"2024-10-04","highlight":{"excerpt":"為此，基於維護臨床醫療作業儀器品質與把關臨床醫療作業儀器使用方式之需求，應有專業醫學工程師執行維護、保養醫療儀器及相關業務，並依法保障醫學工程師之專業及服務，實有建立醫學工程師制度必要性，爰擬具「醫學工程師法草案」。","terms":["臨床","醫療","醫學"],"cut":[false,false]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110068750000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/03/LCEWA01_110203_00179.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110034780000","activity":"bill_primary","title":"「再生醫療製劑條例草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院台灣民眾黨黨團，鑒於再生醫療製劑蓬勃發展，其成分異質性、製程特殊性及治療複雜性，現階段醫院使用再生醫療製劑，從導入前到治療後，藥師皆已參與各個流程，積極發揮調劑及藥品管理專業。","terms":["醫療","治療","醫院","藥品"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034780000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00169.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110068760000","activity":"bill_primary","title":"「全民健康保險法第一條條文修正草案」，請審議案。","meeting":"第11屆第2會期第3次會議","date":"2024-10-04","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於2019年施行《病人自主權利法》後迄今，預立醫療簽署率過低係因諮詢費用過高，導致國人進行預立醫療諮詢意願過低，為改善此一情形，減少臨終前無效醫療，應由全民健康保險法補助國人進行預立醫療諮詢為妥，爰擬具「全民健康保險法","terms":["病人","醫療"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110068760000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/03/LCEWA01_110203_00181.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110097770000","activity":"bill_primary","title":"「全民健康保險法第三條條文修正草案」，請審議案。","meeting":"第11屆第3會期第5次會議","date":"2025-03-14","highlight":{"excerpt":"本院台灣民眾黨黨團，鑒於我國全民健康保險（以下簡稱健保）提供民眾高可近性的醫療服務，實為社會保險制度，然而健保已實施滿三十年，社會各界對於我國醫療保健支出僅占GDP未達7%，遠低於世界其他先進國家，而社會各界呼籲政府應提升至至少8%，以接軌","terms":["健保","醫療"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110097770000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/05/LCEWA01_110305_00062.pdf","printed_pages":null}]}],"labor":[{"person_id":"ly1284","year":2025,"event_id":"bill:202110116620000","activity":"bill_primary","title":"「技術及職業教育法第九條及第二十四條條文修正草案」，請審議案。","meeting":"第11屆第3會期第10次會議","date":"2025-05-02","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於尊嚴勞動是現今國際社會重要之人權保障，將勞動教育納入各級學校教育推動，有助引導學生認識自我潛能，並藉由勞動環境認知，建構完善健康之職業文化，從而促使國人在勞動職場達成自我實現、充分職涯發展及維護勞動權益等社會效益。","terms":["勞動","職場"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110116620000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/10/LCEWA01_110310_00060.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110155090000","activity":"bill_primary","title":"「就業服務法第五十條條文修正草案」，請審議案。","meeting":"第11屆第3會期第24次會議","date":"2025-08-08","highlight":{"excerpt":"本院台灣民眾黨黨團，鑒於現行在台留學生與僑生、華裔學生多有反映打工時數相較他國較無彈性，致使雇主聘用意願較低，或被迫違法增加工時，為避免因而產生打黑工有損其勞動權益與保障，及增加國際人才留才誘因，爰擬具「就業服務法第五十條條文修正草案」。","terms":["工時","雇主","勞動"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110155090000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/24/LCEWA01_110324_00011.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:311110129840000","activity":"bill_primary","title":"函，為院會交付處理或審查「勞動部函為114年度中央政府總預算決議，檢送勞動基金運用局決議（一）第2目項下『基金業務之研考及控管』預算凍結1萬元書面報告」等76案，業已處理或審查完竣，均同意動支，並針對處理或審查情形一覽表中第2案通過附帶決議1項，請查照案。","meeting":"第11屆第3會期第14次會議","date":"2025-06-03","highlight":{"excerpt":"函，為院會交付處理或審查「勞動部函為114年度中央政府總預算決議，檢送勞動基金運用局決議（一）第2目項下『基金業務之研考及控管』預算凍結1萬元書面報告」等76案，業已處理或審查完竣，均同意動支，並針對處理或審查情形一覽表中第2案通過附帶決議","terms":["勞動部","勞動"],"cut":[false,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/311110129840000/details","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110044770000","activity":"bill_primary","title":"「工會法第四條及第六條條文修正草案」，請審議案。","meeting":"第11屆第1會期第13次會議","date":"2024-05-10","highlight":{"excerpt":"本院台灣民眾黨黨團，鑒於憲法第十四條保障人民結社自由，惟現行工會法第四條仍禁止警察及消防員組成工會，難以保障警消人員爭取自身勞動權益。","terms":["工會","勞動"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110044770000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/13/LCEWA01_110113_00104.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110105710000","activity":"bill_primary","title":"「就業服務法第二十四條條文修正草案」，請審議案。","meeting":"第11屆第3會期第8次會議","date":"2025-04-18","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於我國新住民勞參率逐年提升，新住民勞動力逐漸成為我國重要勞動力來源，雖近年政府亦有提出多項協助新住民就業之計畫，然仍未有明確的法源依據。","terms":["勞動"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110105710000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/08/LCEWA01_110308_00129.pdf","printed_pages":null}]}],"law_crime":[{"person_id":"ly1284","year":2025,"event_id":"bill:202110155860000","activity":"bill_primary","title":"「刑事訴訟法第九十三條及第一百零一條條文修正草案」，請審議案。","meeting":"第11屆第3會期第26次會議","date":"2025-08-22","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於司法院大法官釋字第六六五號解釋理由書已指出，羈押係干預身體自由最大之強制處分，僅能以之為保全程序之最後手段，惟實務上，「勾串共犯或證人」之羈押事由已遭嚴重濫用，法院更屢以例稿及空泛模糊理由裁定羈押被告，違反憲法法庭","terms":["司法","法院","法官","羈押"],"cut":[false,true]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110155860000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/26/LCEWA01_110326_00026.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110111170000","activity":"bill_primary","title":"「民事訴訟法第七十七條之二十七條文修正草案」，請審議案。","meeting":"第11屆第3會期第9次會議","date":"2025-04-25","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於臺灣高等法院、福建高等法院金門分院、智慧財產及商業法院依民事訴訟法第七十七條之二十七之授權，修正提高民事訴訟、非訟事件徵收額數標準，經報請司法院核定後，同步於113年12月30日令修正「臺灣高等法院民事訴訟、強制執行","terms":["法院","司法"],"cut":[false,true]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110111170000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/09/LCEWA01_110309_00142.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110155420000","activity":"bill_primary","title":"「法官法第九十條條文修正草案」，請審議案。","meeting":"第11屆第3會期第25次會議","date":"2025-08-15","highlight":{"excerpt":"茲參酌本法第四條有關司法院人事審議委員會組成之規定，爰擬具「法官法第九十條條文修正草案」，減少官派委員人數，並引入外部委員，確保檢察官人事審議委員會之多元代表性，增加檢察官行使職權之獨立性與客觀性。","terms":["司法","法院","法官","檢察官","檢察"],"cut":[false,false]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110155420000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/25/LCEWA01_110325_00024.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110123840000","activity":"bill_primary","title":"「刑事訴訟法第一百零一條之一條文修正草案」，請審議案。","meeting":"第11屆第3會期第11次會議","date":"2025-05-09","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於近年來詐欺、兒少性影像及組織犯罪問題日益嚴峻，此等犯罪不僅有高度社會危害性，亦有高度再犯之情形，自有納為預防性羈押原因之必要，爰擬具「刑事訴訟法第一百零一條之一條文修正草案」。","terms":["詐欺","犯罪","羈押","刑事"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110123840000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/11/LCEWA01_110311_00058.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2025,"event_id":"bill:202110109130000","activity":"bill_primary","title":"「法院組織法部分條文修正草案」，請審議案。","meeting":"第11屆第3會期第8次會議","date":"2025-04-18","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於總統府司改國是會議於一百零六年做成決議，要求法律審之言詞辯論應全面直播，並研議事實審特定案件進行直播；為推動公開透明之司法，落實總統府司改國是會議之決議，爰擬具「法院組織法部分條文修正草案」，明定法律審應採「原則公","terms":["司改","司法","法院"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110109130000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/18/LCEWA01_110318_00188.pdf","printed_pages":null}]}],"social_welfare":[{"person_id":"ly1284","year":2024,"event_id":"bill:202110056080000","activity":"bill_primary","title":"「國民年金法第五十四條之一條文修正草案」，請審議案。","meeting":"第11屆第1會期第18次會議","date":"2024-06-14","highlight":{"excerpt":"為加強照顧弱勢民眾的基本生活，使國民年金法能妥受照顧並保障弱勢民眾，爰擬具「國民年金法第五十四條之一條文修正草案」，以減緩物價通膨之傷害，並確保我國經濟弱勢國民老年經濟安全。","terms":["弱勢","國民年金","年金"],"cut":[false,false]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110056080000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/18/LCEWA01_110118_00036.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110041320000","activity":"bill_primary","title":"「性別平等工作法第三條、第十六條及第十七條條文修正草案」，請審議案。","meeting":"第11屆第1會期第12次會議","date":"2024-05-03","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於少子化國安危機，現行育嬰留職停薪制度實則過於嚴苛且缺乏彈性，為優化職場育兒配套措施改善，降低雙薪家庭苦於無充足時間安心陪伴子女成長的憂慮，爰擬具「性別平等工作法第三條、第十六條及第十七條條文修正草案」，修正育嬰留職停","terms":["育嬰","育兒"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110041320000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/12/LCEWA01_110112_00082.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110041330000","activity":"bill_primary","title":"「就業保險法第十條、第十一條及第十九條之二條文修正草案」，請審議案。","meeting":"第11屆第1會期第12次會議","date":"2024-05-03","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於少子化國安危機，現行育嬰留職停薪制度實則過於嚴苛且缺乏彈性，為優化職場育兒配套措施改善，降低雙薪家庭苦於無充足時間安心陪伴子女成長的憂慮，爰配合修訂「性別平等工作法第十六條條文修正草案」將育嬰留職停薪修正為育兒留職停","terms":["育嬰","育兒"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110041330000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/12/LCEWA01_110112_00083.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110056090000","activity":"bill_primary","title":"「社會救助法第十一條條文修正草案」，請審議案。","meeting":"第11屆第1會期第18次會議","date":"2024-06-14","highlight":{"excerpt":"為加強照顧弱勢民眾的基本生活，並落實憲法保障人民生存權與扶弱濟傾為憲法明定之國家義務，使社會救助法提供弱勢民眾生活扶助金以維持其基本生活之目的，爰擬具「社會救助法第十一條條文修正草案」，將現金給付所定金額由每四年調整一次修正為每兩年調整一次","terms":["弱勢","社會救助"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110056090000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/18/LCEWA01_110118_00037.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110084720000","activity":"bill_primary","title":"「國民年金法第十五條及第五十條條文修正草案」，請審議案。","meeting":"第11屆第2會期第16次會議","date":"2025-01-03","highlight":{"excerpt":"又本法被保險人因婚姻關係及其配偶間，以互負連帶繳納義務之名，而承受加重經濟負擔之特別不利益，造成該投保之弱勢族群家庭產生弱弱互保，似與憲法平等原則及婚姻家庭保障之意旨不符，爰擬具「國民年金法第十五條及第五十條條文修正草案」。","terms":["弱勢","國民年金","年金"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110084720000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/16/LCEWA01_110216_00037.pdf","printed_pages":null}]}],"technology":[{"person_id":"ly1284","year":2024,"event_id":"bill:202110060360000","activity":"bill_primary","title":"「外送平台管理暨從業人員權益保障法草案」，請審議案。","meeting":"第11屆第1會期第21次會議","date":"2024-07-05","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於數位平台發展出的新型經濟型態（下稱數位平台經濟）日益普及，平台業者、平台勞務提供者（下稱外送員）和勞務需求者之間衍生之勞動問題愈趨複雜，且非現行勞動法令所能有效規範。","terms":["數位"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110060360000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/21/LCEWA01_110121_00038.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"bill:202110034790000","activity":"bill_primary","title":"「再生醫療法草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"而再生醫療係將基因、細胞及其衍生物用於人體構造或功能之重建或修復，或用於人類疾病之治療及預防，係目前醫療發展之新興科技。","terms":["科技"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034790000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00170.pdf","printed_pages":null}]},{"person_id":"ly1284","year":2024,"event_id":"speech:ac7e1f89f00ea9a6","activity":"speech","title":"第11屆第1會期社會福利及衛生環境、司法及法制委員會第1次聯席會議","meeting":"第11屆第1會期社會福利及衛生環境、司法及法制委員會第1次聯席會議","date":"2024-04-29","highlight":{"excerpt":"我再強調，我個人都支持大家用「網路業者」這樣的名稱，但是網路業者根據原來的法條裡面，它是有定義的，我們是不是第一次提及的時候，應該把過去寫的網路網際平臺提供者、網際網路應用服務提供者及網際網路接取服務提供者，就是先括號一次，然後才進入網路業","terms":["網路","網際網路"],"cut":[false,true]},"hits":10,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/37/LCIDC01_1133701.pdf","printed_pages":"357-440"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/37/LCIDC01_1133701.pdf","printed_pages":"131-356"}]},{"person_id":"ly1284","year":2024,"event_id":"speech:07c33659352f5e45","activity":"speech","title":"第11屆第1會期交通委員會第3次全體委員會議","meeting":"第11屆第1會期交通委員會第3次全體委員會議","date":"2024-03-11","highlight":{"excerpt":"請問主委與NCC，對於當時三董一監所陳報的鏡電視報告已經明白點出鏡電視很多作為違反NCC核發新聞臺執照的附款要求，而且也和董事長蔡滄波隱瞞三董一監正式回給NCC的報告內容互相牴觸、南轅北轍，當時NCC做了什麼樣的調查或有行政作為嗎？","terms":["NCC"],"cut":[false,false]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/11/LCIDC01_1131101.pdf","printed_pages":"1-142"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/11/LCIDC01_1131101.pdf","printed_pages":"1-142"}]},{"person_id":"ly1284","year":2024,"event_id":"speech:940a5b03786eb810","activity":"speech","title":"第11屆第1會期社會福利及衛生環境委員會第12次全體委員會議","meeting":"第11屆第1會期社會福利及衛生環境委員會第12次全體委員會議","date":"2024-04-15","highlight":{"excerpt":"過去散布私密影像的業者認為虛擬貨幣無法追蹤足跡，但事實上現在科技做得到，我想不管是衛福部還有今天在座的數位部、法務部，尤其是數位部！","terms":["科技","數位"],"cut":[false,false]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/29/LCIDC01_1132901.pdf","printed_pages":"341-422"},{"kind":"gazette_pdf","url":"https://ppg.ly.go