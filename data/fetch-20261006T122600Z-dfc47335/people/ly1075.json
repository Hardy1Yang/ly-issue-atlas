":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/09/LCEWA01_110209_00017.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"bill:202110029210000","activity":"bill_primary","title":"「證券交易法第一百五十五條條文修正草案」，請審議案。","meeting":"第11屆第1會期第9次會議","date":"2024-04-12","highlight":{"excerpt":"本院委員王世堅等17人，鑒於證券交易法第一百五十五條第一項各款之規範過於空泛，特別是第三、四、五款之構成要件有諸多不明確之處，然現行法復未透過證券交易法施行細則或其他規範補充、確立標準，該結果將導致投資人無從確認如何免於受證券交易法處罰，並","terms":["證券","投資人"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110029210000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/09/LCEWA01_110109_00027.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"bill:202110076530000","activity":"bill_primary","title":"「保險法部分條文修正草案」，請審議案。","meeting":"第11屆第2會期第9次會議","date":"2024-11-15","highlight":{"excerpt":"本院委員王世堅、王美惠、蔡其昌等18人，鑒於為賦予保險業作業委託他人處理之法律授權依據；為維護國內保險業無法承保之特定對象權益及保險市場秩序；為確保保險契約經扣押或受強制執行時，保戶得維持生活經濟所必需之基本保險保障，且被保險人及受益人等人","terms":["保險業"],"cut":[false,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110076530000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/09/LCEWA01_110209_00013.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2025,"event_id":"bill:202110129950000","activity":"bill_primary","title":"「電子支付機構管理條例第十五條條文修正草案」，請審議案。","meeting":"第11屆第3會期第14次會議","date":"2025-06-03","highlight":{"excerpt":"本院委員王世堅、伍麗華Saidhai Tahovecahe等17人，參考金融監督管理委員會銀行局102年度之對外發言意旨，明示中國大陸地區之電子支付機構非我國電子支付機構可合作之境外電子支付機構，爰擬具「電子支付機構管理條例第十五條條文修正","terms":["金融","銀行"],"cut":[false,true]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110129950000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/14/LCEWA01_110314_00040.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2025,"event_id":"bill:202110129960000","activity":"bill_primary","title":"「文化創意產業發展法第十條之一條文修正草案」，請審議案。","meeting":"第11屆第3會期第14次會議","date":"2025-06-03","highlight":{"excerpt":"黃牛行為的裁罰是基於票面金額，免費票券並不適用，使黃牛有機可乘；又黃牛的調查或取締，僅洽請警察機關協助屬實不足，亦須請金融及其他相關機關提供協助，為使金融及其他相關機關提供協助有法源依據，爰擬具「文化創意產業發展法第十條之一條文修正草案」。","terms":["金融"],"cut":[true,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110129960000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/14/LCEWA01_110314_00041.pdf","printed_pages":null}]}],"housing":[{"person_id":"ly1075","year":2024,"event_id":"bill:202110081420000","activity":"bill_primary","title":"「都更危老整合業管理條例草案」，請審議案。","meeting":"第11屆第2會期第12次會議","date":"2024-12-06","highlight":{"excerpt":"本院委員林岱樺、王世堅等19人，為管理都更危老整合業，保障老舊社區土地及合法建築物所有權人、都更危老整合人以及利害關係人之權益，促進都市更新加速發展，爰擬具「都更危老整合業管理條例草案」。","terms":["都更","危老","都市更新"],"cut":[false,false]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110081420000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/12/LCEWA01_110212_00048.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"speech:64cfd68ef05a26ae","activity":"speech","title":"第11屆第1會期財政委員會第12次全體委員會議","meeting":"第11屆第1會期財政委員會第12次全體委員會議","date":"2024-05-15","highlight":{"excerpt":"我只補充一句話，很多我們可以界定，像垃圾是什麼，或是沒有建照但你來，可是社會住宅絕對不是什麼亂七八糟的東西，社會住宅是政府首要的住宅政策之一，所以我希望能夠把……現在既然REITs要這樣發行，我們鼓勵這些資金來參與了，畢其功於一役，把最重要","terms":["社會住宅","住宅"],"cut":[false,true]},"hits":8,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/46/LCIDC01_1134601.pdf","printed_pages":"115-398"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/46/LCIDC01_1134601.pdf","printed_pages":"115-398"}]},{"person_id":"ly1075","year":2024,"event_id":"speech:530d47f5099e85b9","activity":"speech","title":"第11屆第2會期財政委員會第9次全體委員會議","meeting":"第11屆第2會期財政委員會第9次全體委員會議","date":"2024-11-18","highlight":{"excerpt":"部長，你講的都有些道理啦，但是我把結論跟你講，結論是現在我們國家到今年為止整體的空屋率，5年內的新房屋空屋率高達34%，每3戶有1戶是空屋，已經到這樣的地步，已經很清楚、很明顯的看到有炒房族、囤房族，他們運用稅制上這一部分寬鬆、稅率過低，他","terms":["空屋","房屋","囤房"],"cut":[false,true]},"hits":6,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/101/LCIDC01_11310101.pdf","printed_pages":"133-212"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/101/LCIDC01_11310101.pdf","printed_pages":"133-212"}]},{"person_id":"ly1075","year":2024,"event_id":"speech:b8fe291d30fe8fdc","activity":"speech","title":null,"meeting":null,"date":"2025-01-06","highlight":{"excerpt":"，他們做這部分的授信，金額做得夠多也夠大，但是他如果冷靜想，他把1,150億借給建商去做空地貸款，而不去催收的話，1坪土地我們以100萬來算，等於讓建商空有11萬坪的土地，買著11萬坪的土地，在那邊買地、養地、圈地，難怪我們升斗小民要買房子","terms":["建商","房子"],"cut":[true,true]},"hits":5,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/17/LCIDC01_1141702.pdf","printed_pages":"1-422"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/17/LCIDC01_1141702.pdf","printed_pages":"1-422"}]},{"person_id":"ly1075","year":2024,"event_id":"speech:96da36b70a072a91","activity":"speech","title":"第11屆第2會期財政委員會第8次全體委員會議","meeting":"第11屆第2會期財政委員會第8次全體委員會議","date":"2024-11-13","highlight":{"excerpt":"就好，2,000億可以買100萬的建地買20萬坪耶，也就是說我們公營行庫體系隨時擺著2,000億給這些不肖建商拿去買地、圈地、養地，變相的助長他們炒作房地產，變相的助長不肖建商拉抬房價，難怪全國各地不只首都而已，你看這兩三年來房地產的漲幅。","terms":["建商","房地產","房價"],"cut":[true,false]},"hits":5,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/100/LCIDC01_11310002.pdf","printed_pages":"13-172"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/156831","printed_pages":null}]}],"law_crime":[{"person_id":"ly1075","year":2025,"event_id":"bill:202110177150000","activity":"bill_primary","title":"「中華民國刑法第八十三條條文修正草案」，請審議案。","meeting":"第11屆第4會期第12次會議","date":"2025-12-05","highlight":{"excerpt":"本院委員吳思瑤、徐富癸、王世堅等18人，鑑於性侵害及性剝削犯罪本質具有隱密性，被害人案發時如尚未成年，其身心發展尚未成熟，對於因遭性侵害或性剝削犯罪後往往因心理創傷或未能充分理解可得行使之法律上權利，或因與加害人權力不對等，使被害人未能及時","terms":["犯罪"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110177150000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/12/LCEWA01_110412_00061.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2025,"event_id":"bill:202110177160000","activity":"bill_primary","title":"「中華民國刑法施行法增訂第八條之三條文草案」，請審議案。","meeting":"第11屆第4會期第12次會議","date":"2025-12-05","highlight":{"excerpt":"本院委員吳思瑤、徐富癸、王世堅等18人，為配合刑法第八十三條條文修正定明特定類型犯罪之案件於被害人成年前，追訴權之時效停止進行，鑑於貫徹刑法第八十三條條文修正之立法目的，定明追訴權時效未完成之案件，應適用修正後之時效規定，爰擬具「中華民國刑","terms":["刑法","犯罪"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110177160000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/12/LCEWA01_110412_00062.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2025,"event_id":"bill:202110182650000","activity":"bill_primary","title":"「詐欺犯罪危害防制條例部分條文修正草案」，請審議案。","meeting":"第11屆第4會期第17次會議","date":"2026-01-09","highlight":{"excerpt":"本院委員王世堅、陳冠廷、徐富癸、陳素月、蔡易餘等16人，鑒於現今詐騙手法不斷推陳出新，然現行制度在司法警察、金融機構間的資訊流通、預警機制與跨業聯防上仍存有斷點，致使第一線難以及時辨識被害人、警示異常帳戶並有效攔阻可疑金流。","terms":["詐騙","司法","警察"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110182650000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/17/LCEWA01_110417_00007.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"bill:202110029170000","activity":"bill_primary","title":"「中華民國刑法第三百三十九條、第三百三十九條之三及第三百三十九條之四條文修正草案」，請審議案。","meeting":"第11屆第1會期第9次會議","date":"2024-04-12","highlight":{"excerpt":"本院委員王世堅等22人，鑒於近期詐欺犯罪朝向集團化、網路化發展，現行法規不足以完整評價行為人之罪質及行為之實害性。","terms":["詐欺","犯罪"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110029170000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/09/LCEWA01_110109_00023.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"bill:202110079820000","activity":"bill_primary","title":"「外役監條例第四條及第二十一條條文修正草案」，請審議案。","meeting":"第11屆第2會期第11次會議","date":"2024-11-29","highlight":{"excerpt":"本院委員王世堅、莊瑞雄等19人，鑒於近年都會區一般監所超額收容情形加重，造成一般監所負擔沉重，又外役監設立之目的為使受刑人逐步適應社會生活，而返家探視為接軌社會的最佳方法。","terms":["受刑人"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110079820000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/11/LCEWA01_110211_00037.pdf","printed_pages":null}]}],"macroeconomy":[{"person_id":"ly1075","year":2024,"event_id":"bill:202110036750000","activity":"bill_primary","title":"「加值型及非加值型營業稅法部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第11次會議","date":"2024-04-26","highlight":{"excerpt":"Tahovecahe、王世堅、林宜瑾、莊瑞雄、羅美玲等23人，鑒於現行實施加值型營業稅制度國家多採單一自動報繳機制，我國自民國七十五年由總額型營業稅制度導入加值型營業稅制度時，尚保留查定課徵營業稅制度以資過渡，考量雙軌並行實施迄今已近四十年","terms":["營業稅","稅制"],"cut":[true,true]},"hits":15,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110036750000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/11/LCEWA01_110111_00023.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"bill:202110029200000","activity":"bill_primary","title":"廢止「印花稅法」，請審議案。","meeting":"第11屆第1會期第9次會議","date":"2024-04-12","highlight":{"excerpt":"但外界對同一交易行為須核課印花稅及營業稅等稅目時有重複課稅疑慮、徵納雙方對於憑證是否構成課稅憑證及究屬何類課稅憑證時有爭議、印花稅採貼花或彙總申報完稅方式不易控管易生逃漏、主張合約於國外簽訂以規避稅負、印花稅稅源可跨縣市流動造成地方政府間爭","terms":["營業稅","課稅"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110029200000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/09/LCEWA01_110109_00026.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2024,"event_id":"bill:202110076550000","activity":"bill_primary","title":"「所得稅法第五條條文修正草案」，請審議案。","meeting":"第11屆第2會期第9次會議","date":"2024-11-15","highlight":{"excerpt":"顯見現行稅制難以發揮所得重分配功能，為減少貧富差距，並符量能課稅，爰擬具「所得稅法第五條條文修正草案」。","terms":["稅制","課稅","所得稅","稅法"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110076550000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/09/LCEWA01_110209_00015.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2025,"event_id":"bill:202110129980000","activity":"bill_primary","title":"「老年農民福利津貼暫行條例第二條及第四條條文修正草案」，請審議案。","meeting":"第11屆第3會期第14次會議","date":"2025-06-03","highlight":{"excerpt":"本院委員王世堅、賴惠員等16人，鑒於本法於民國100年修法至今，其所定之津貼金額、排富條款等，皆未調整；然近兩年消費者物價指數皆超過通膨警戒線、且重要民生物資物價漲幅更劇。","terms":["物價","通膨"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110129980000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/14/LCEWA01_110314_00043.pdf","printed_pages":null}]},{"person_id":"ly1075","year":2025,"event_id":"bill:202110127130000","activity":"bill_primary","title":"「貨物稅條例第十一條之一條文修正草案」，請審議案。","meeting":"第11屆第3會期第12次會議","date":"2025-05-16","highlight":{"excerpt":"惟本優惠措施將屆，應檢討其續行之可行性與必要性，爰擬具「貨物稅條例第十一條之一條文修正草案」，延長購買節能電器者之減徵貨物稅優惠至2027年，並得視推動成效與社會需求延長。","terms":["貨物稅","減徵"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110127130000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/15/LCEWA01_11