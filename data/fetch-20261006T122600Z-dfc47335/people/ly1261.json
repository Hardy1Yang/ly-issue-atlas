ntual_count":43,"undated_count":34,"bills":151},{"year":2024,"stage":"withdrawn","as_of":"2025-01-31","as_of_count":1,"eventual_count":1,"undated_count":0,"bills":151},{"year":2024,"stage":"rejected","as_of":"2025-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":151},{"year":2024,"stage":"for_record","as_of":"2025-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":151},{"year":2024,"stage":"scheduled","as_of":"2025-01-31","as_of_count":27,"eventual_count":28,"undated_count":0,"bills":151},{"year":2024,"stage":"flow_unknown","as_of":"2025-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":151}],"records":{"culture":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110034820000","activity":"bill_primary","title":"「文化基本法第二十四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於文化基本法第二十四條第二項明定文化部應設置文化發展基金，辦理文化發展及公共媒體等相關事項，然現行法規並未明定基金財源，為使基金籌措有所依據，並健全基金運作，爰擬具「文化基本法第二十四條條文修正草案」。","terms":["文化","文化部"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034820000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00173.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110081360000","activity":"bill_primary","title":"「教育部組織法第二條、第五條及第九條條文修正草案」，請審議案。","meeting":"第11屆第2會期第12次會議","date":"2024-12-06","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於配合體育暨運動發展部成立，刪除原先隸屬於教育部下之相關條文，原由教育部體育署辦理之全民運動、競技運動、運動產業、國際與兩岸運動及運動設施政策規劃、輔導及行政監督等事項，改交由升格後之體育暨運動發展部辦理，爰擬具「教育","terms":["體育","競技"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110081360000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/15/LCEWA01_110215_00167.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110081350000","activity":"bill_primary","title":"「體育暨運動發展部全民運動署組織法草案」，請審議案。","meeting":"第11屆第2會期第12次會議","date":"2024-12-06","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於「競技運動全民化」之目標，運動推廣不能光是追求競技成就，發展運動金字塔並強調基層運動的普及以促進全民運動，並強化新興運動、社區運動、全齡運動之推展，以加強全民之運動風氣、促進國民健康，有設全民運動署辦理相關業務之必要","terms":["競技"],"cut":[false,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110081350000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/15/LCEWA01_110215_00152.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110069850000","activity":"bill_primary","title":"「體育暨運動發展部組織法草案」，請審議案。","meeting":"第11屆第2會期第4次會議","date":"2024-10-11","highlight":{"excerpt":"策層級、缺乏跨部會統籌能力、具政策性質卻無常設法源依據之組織等問題，應提升教育部體育署之位階，成為行政院所屬中央二級機關，故設立運動發展部以更有效地整合資源，提升行政效能，促進全民運動及產業發展，以創造經濟效益，同時提升我國在國際體育組織中","terms":["體育"],"cut":[true,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110069850000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/04/LCEWA01_110204_00056.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110056060000","activity":"bill_primary","title":"「社會秩序維護法第六十四條及第七十二條條文修正草案」，請審議案。","meeting":"第11屆第1會期第18次會議","date":"2024-06-14","highlight":{"excerpt":"以黃牛票為例，我國雖於2023年通過「文化創意產業發展法」第十條之一規範藝文活動票券之販售之運作、「運動產業發展條例」第二十四條之一，使民眾均有平等參與運動賽事或活動的機會，希冀透過上開法律抑制黃牛票之情況，「醫療掛號之票券」黃牛條款漏未規","terms":["文化","藝文","賽事"],"cut":[false,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110056060000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/18/LCEWA01_110118_00034.pdf","printed_pages":null}]}],"education":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110072630000","activity":"bill_primary","title":"「偏遠地區學校教育發展條例第七條及第八條條文修正草案」，請審議案。","meeting":"第11屆第2會期第6次會議","date":"2024-10-25","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於為協助穩定偏遠地區學校師資，以實現教育機會平等原則，確保偏遠地區教育之均衡發展，並因應偏遠地區學校之特性與需求，改善其師資與學習條件，提升偏遠地區學校學生學習品質，並平衡城鄉教育，爰擬具「偏遠地區學校教育發展條例第七","terms":["學校","師資","教育","學生"],"cut":[false,true]},"hits":18,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110072630000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/06/LCEWA01_110206_00260.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110069810000","activity":"bill_primary","title":"「國民教育法第三條及第四條條文修正草案」，請審議案。","meeting":"第11屆第2會期第4次會議","date":"2024-10-11","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於我國已自民國100年起開始實施高度具備國民教育辦理精神及具義務教育雛型之五歲幼兒免學費政策，我國當前面臨少子女化危機，應先將國民教育年齡向下延伸一年，以擴大國民教育，減輕家長負擔，進而增加生育誘因，鼓勵生育現為增加我","terms":["教育","學費"],"cut":[false,true]},"hits":11,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110069810000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/04/LCEWA01_110204_00052.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110081360000","activity":"bill_primary","title":"「教育部組織法第二條、第五條及第九條條文修正草案」，請審議案。","meeting":"第11屆第2會期第12次會議","date":"2024-12-06","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於配合體育暨運動發展部成立，刪除原先隸屬於教育部下之相關條文，原由教育部體育署辦理之全民運動、競技運動、運動產業、國際與兩岸運動及運動設施政策規劃、輔導及行政監督等事項，改交由升格後之體育暨運動發展部辦理，爰擬具「教育","terms":["教育部","教育"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110081360000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/15/LCEWA01_110215_00167.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110072640000","activity":"bill_primary","title":"「強迫入學條例第二條及第七條條文修正草案」，請審議案。","meeting":"第11屆第2會期第6次會議","date":"2024-10-25","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於我國已自民國100年起開始實施高度具備國民教育辦理精神及具義務教育雛型之五歲幼兒免學費政策，為儘速推動5歲幼兒教育義務化，使幼兒得到更好的教育資源，減輕家長負擔，並厚植國家未來資產，故配合「國民教育法部分條文修正草案","terms":["教育","學費"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110072640000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/06/LCEWA01_110206_00261.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110055090000","activity":"bill_primary","title":"「教育基本法增訂第八條之一條文草案」，請審議案。","meeting":"第11屆第1會期第17次會議","date":"2024-06-07","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於政府機關、民間團體舉辦各式活動，有商請學校學生參與表演或擔任工作人員之習，相關表演、活動除師生職工需耗時練習、採排，交通、住宿、添置設備、道具、服裝或聘請外部人員之經費亦多由校方或社團自行籌措，不但影響學生日常學習進","terms":["學校","學生"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110055090000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/17/LCEWA01_110117_00057.pdf","printed_pages":null}]}],"health":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110034790000","activity":"bill_primary","title":"「再生醫療法草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"再者，再生醫療為嶄新、複雜、又需高額花費的醫療科技領域，任何單一專業都孤掌難鳴，難以成就再生醫療之大事，此法應依據醫師、藥師、生醫、化學、醫工等各領域人員之專業進行分工，惟其生醫療領域龐大，可再約略區分為細胞治療、基因治療與組織工程三個子領","terms":["醫療","醫師","治療"],"cut":[false,true]},"hits":13,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034790000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00170.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110068750000","activity":"bill_primary","title":"「醫學工程師法草案」，請審議案。","meeting":"第11屆第2會期第3次會議","date":"2024-10-04","highlight":{"excerpt":"為此，基於維護臨床醫療作業儀器品質與把關臨床醫療作業儀器使用方式之需求，應有專業醫學工程師執行維護、保養醫療儀器及相關業務，並依法保障醫學工程師之專業及服務，實有建立醫學工程師制度必要性，爰擬具「醫學工程師法草案」。","terms":["臨床","醫療","醫學"],"cut":[false,false]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110068750000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/03/LCEWA01_110203_00179.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110037640000","activity":"bill_primary","title":"「全民防衛動員準備法第三條及第六條條文修正草案」，請審議案。","meeting":"第11屆第1會期第11次會議","date":"2024-04-26","highlight":{"excerpt":"時常飛越海峽中線造成與我國之矛盾外，公共衛生環境的挑戰，例如：特殊嚴重傳染性肺炎疫情所帶來的浩劫，造成諸多國人的死亡以及社會環境劇烈挑戰殷鑑不遠，該疫情於我國肆虐超過兩年，政府用以防治疫情之人力及物力之動員規模前所未有，為呼應傳染病防治法第","terms":["疫情","傳染病"],"cut":[true,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110037640000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/11/LCEWA01_110111_00155.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110034780000","activity":"bill_primary","title":"「再生醫療製劑條例草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院台灣民眾黨黨團，鑒於再生醫療製劑蓬勃發展，其成分異質性、製程特殊性及治療複雜性，現階段醫院使用再生醫療製劑，從導入前到治療後，藥師皆已參與各個流程，積極發揮調劑及藥品管理專業。","terms":["醫療","治療","醫院","藥品"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034780000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00169.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110068760000","activity":"bill_primary","title":"「全民健康保險法第一條條文修正草案」，請審議案。","meeting":"第11屆第2會期第3次會議","date":"2024-10-04","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於2019年施行《病人自主權利法》後迄今，預立醫療簽署率過低係因諮詢費用過高，導致國人進行預立醫療諮詢意願過低，為改善此一情形，減少臨終前無效醫療，應由全民健康保險法補助國人進行預立醫療諮詢為妥，爰擬具「全民健康保險法","terms":["病人","醫療"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110068760000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/03/LCEWA01_110203_00181.pdf","printed_pages":null}]}],"labor":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110069860000","activity":"bill_primary","title":"「法律扶助法第十四條及第六十五條條文修正草案」，請審議案。","meeting":"第11屆第2會期第4次會議","date":"2024-10-11","highlight":{"excerpt":"又，鑒於勞政與移民業務人員屬處理弱勢移工與新住民重傷害、性侵害或職災案件之第一線人員，復審酌我國司法官、律師、司法警察（官）與移工間存在之語言隔閡，難以有效、即時轉述告知被害移工、新住民其得申請法律扶助之權益，基於保障移工與弱勢新住民之司法","terms":["移工","職災"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110069860000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/04/LCEWA01_110204_00057.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110082420000","activity":"bill_primary","title":"「職場霸凌防治法草案」，請審議案。","meeting":"第11屆第2會期第13次會議","date":"2024-12-13","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於現行公、私部門職場霸凌定義不清、規範密度不足，難以有效嚇阻職場霸凌事件之發生，無法充分保護職場霸凌事件之被害人，有必要訂立專法防治職場霸凌，茲參酌性騷擾防治法等相關法規，爰擬具「職場霸凌防治法草案」。","terms":["職場"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110082420000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/13/LCEWA01_110213_00038.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110078980000","activity":"bill_primary","title":"「勞工退休金條例部分條文修正草案」，請審議案。","meeting":"第11屆第2會期第10次會議","date":"2024-11-22","highlight":{"excerpt":"現行勞工自提退休金由勞動部基金運用局管理運用，勞工退休金收益雖由政府保障兩年期定存，惟利率過低將使勞工未來退休金不足以支撐基本生活。","terms":["勞工","勞動部","勞動"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110078980000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/10/LCEWA01_110210_00103.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110069900000","activity":"bill_primary","title":"「勞動檢查法第十五條條文修正草案」，請審議案。","meeting":"第11屆第2會期第4次會議","date":"2024-10-11","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於勞動檢查亦屬行政調查之一環，為使事業單位或有關人員在實施勞動檢查時，基於為維護其自身權益之必要，在不侵害勞檢人員隱私權之情況下，得在勞檢過程中自行拍攝照片、錄音或錄影，爰擬具「勞動檢查法第十五條條文修正草案」。","terms":["勞動","勞檢"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110069900000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/04/LCEWA01_110204_00061.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110050400000","activity":"bill_primary","title":"「勞動基準法第五十四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第15次會議","date":"2024-05-24","highlight":{"excerpt":"然而，現行勞動基準法明定強制勞工退休年齡為65歲，對於壯世代族群繼續於投入就業職場上有所限制，不利勞動參與的提升。","terms":["勞動","勞動基準法","勞工","職場"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110050400000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/15/LCEWA01_110115_00070.pdf","printed_pages":null}]}],"law_crime":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110034770000","activity":"bill_primary","title":"「中華民國刑法第三百三十九條之四條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於犯罪組織之成員透過組織犯罪進行加重詐欺之犯罪型態，不僅日益猖獗，更已造成越來越嚴重的社會危害，導致許多被害人家破人亡，現行法之解釋適用卻無法有效抑制，在涉及犯罪組織成員透過組織犯罪進行加重詐欺之犯行時，雖然其所造成","terms":["犯罪","詐欺"],"cut":[false,true]},"hits":14,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034770000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00168.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110067480000","activity":"bill_primary","title":"「刑事訴訟法部分條文修正草案」，請審議案。","meeting":"第11屆第2會期第1次會議","date":"2024-09-20","highlight":{"excerpt":"此外，根據中華民國憲法第八條第二項、刑事訴訟法第九十三條第二項及第二百二十八條第四項之規定，若檢察官於偵查中認為被告或犯罪嫌疑人有羈押之必要，應自拘提或逮捕後二十四小時內向法院聲請羈押。","terms":["刑事","檢察官","檢察","偵查","犯罪","羈押","法院"],"cut":[false,false]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110067480000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/01/LCEWA01_110201_00027.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110069870000","activity":"bill_primary","title":"「中華民國刑法部分條文修正草案」，請審議案。","meeting":"第11屆第2會期第4次會議","date":"2024-10-11","highlight":{"excerpt":"在另一方面，作為死刑替代刑罰手段之「無期徒刑」，在我國實務上已形同虛設，自102年至111年無期徒刑受刑人假釋出獄人數為657人，在監執行時間平均僅為17.9年，非但造成無期徒刑制度之空洞化，更難以實現社會公平正義。","terms":["死刑","徒刑","受刑人","假釋"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110069870000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/04/LCEWA01_110204_00058.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110050410000","activity":"bill_primary","title":"「詐欺犯罪危害防制條例草案」，請審議案。","meeting":"第11屆第1會期第15次會議","date":"2024-05-24","highlight":{"excerpt":"本院台灣民眾黨黨團，為強化我國詐欺犯罪防制制度，且為嚇阻詐欺犯罪，爰擬具「詐欺犯罪危害防制條例草案」。","terms":["詐欺","犯罪"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110050410000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/15/LCEWA01_110115_00066.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110034720000","activity":"bill_primary","title":"「刑事訴訟法部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院台灣民眾黨黨團，有鑑於因應日新月異之犯罪手法與科技發展，檢警調於偵辦舉凡暴力組織、吸金詐騙、毒品查緝、槍砲彈藥以及貪污受賄等重大犯罪，均有使用科技方法之必要，始得有效打擊犯罪、維護社會秩序。","terms":["犯罪","詐騙","毒品","貪污"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034720000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00163.pdf","printed_pages":null}]}],"social_welfare":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110055800000","activity":"bill_primary","title":"「就業保險法第十條、第十一條及第十九條之二條文修正草案」，請審議案。","meeting":"第11屆第1會期第18次會議","date":"2024-06-14","highlight":{"excerpt":"為改善少子女化國安危機，促進適齡生育夫妻撫育子女，應保障適齡生育夫妻之經濟負擔，調升育嬰留職停薪津貼為八成，並延長請領育嬰留職停薪津貼之時間上限，由六個月延長為十二個月，由於台灣面臨少子女化危機，為鼓勵適齡生育夫妻撫育子女，並營造友善育兒環","terms":["生育","育嬰","育兒"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110055800000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/18/LCEWA01_110118_00030.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110056080000","activity":"bill_primary","title":"「國民年金法第五十四條之一條文修正草案」，請審議案。","meeting":"第11屆第1會期第18次會議","date":"2024-06-14","highlight":{"excerpt":"為加強照顧弱勢民眾的基本生活，使國民年金法能妥受照顧並保障弱勢民眾，爰擬具「國民年金法第五十四條之一條文修正草案」，以減緩物價通膨之傷害，並確保我國經濟弱勢國民老年經濟安全。","terms":["弱勢","國民年金","年金"],"cut":[false,false]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110056080000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/18/LCEWA01_110118_00036.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110050390000","activity":"bill_primary","title":"「兒童及少年福利與權益保障法第二十三條及第三十一條之一條文修正草案」，請審議案。","meeting":"第11屆第1會期第15次會議","date":"2024-05-24","highlight":{"excerpt":"或處境，必須在學齡後持續接受復健並接受政府幫助，以台北市為例，其於112年放寬「弱勢兒童及少年醫療補助」對象，對於6到18歲低收入戶、中低收入戶家庭兒童、領有弱勢家庭兒童及青少年緊急生活扶助、罕病或重大傷病之兒少，經醫生診斷發展遲緩或有持續","terms":["弱勢","低收入","兒少"],"cut":[true,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110050390000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/15/LCEWA01_110115_00067.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110047860000","activity":"bill_primary","title":"「老年農民福利津貼暫行條例第二條、第三條及第四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","highlight":{"excerpt":"，例如：「公立學校教職員退休資遣撫卹條例」中自願退休年齡從65歲降低為55歲、「國民年金法」中原住民給付亦從55歲開始適用、國民長照2.0政策上，「長照法」亦擴大服務至55歲失能老人等，惟「老年農民福利津貼暫行條例」針對原住民餘命不平等問題","terms":["國民年金","年金","長照2.0","長照","老人"],"cut":[true,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110047860000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/14/LCEWA01_110114_00076.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110041320000","activity":"bill_primary","title":"「性別平等工作法第三條、第十六條及第十七條條文修正草案」，請審議案。","meeting":"第11屆第1會期第12次會議","date":"2024-05-03","highlight":{"excerpt":"本院台灣民眾黨黨團，鑑於少子化國安危機，現行育嬰留職停薪制度實則過於嚴苛且缺乏彈性，為優化職場育兒配套措施改善，降低雙薪家庭苦於無充足時間安心陪伴子女成長的憂慮，爰擬具「性別平等工作法第三條、第十六條及第十七條條文修正草案」，修正育嬰留職停","terms":["育嬰","育兒"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110041320000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/12/LCEWA01_110112_00082.pdf","printed_pages":null}]}],"technology":[{"person_id":"ly1261","year":2024,"event_id":"bill:202110067470000","activity":"bill_primary","title":"「新聞媒體與數位科技平台公平發展法草案」，請審議案。","meeting":"第11屆第2會期第1次會議","date":"2024-09-20","highlight":{"excerpt":"本院台灣民眾黨黨團，為促進數位科技產業與新聞媒體產業平衡發展，並解決數位科技平台與新聞媒體業者間議價地位不對等之問題，並考量永續發展新聞媒體產業，設置「數位新聞發展基金」，由大型數位科技平台業者提撥一定比例之營收，以協助改善本土新聞媒體經營","terms":["數位","科技"],"cut":[false,true]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110067470000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/01/LCEWA01_110201_00026.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110050360000","activity":"bill_primary","title":"「電信管理法第九條及第四十條條文修正草案」，請審議案。","meeting":"第11屆第1會期第15次會議","date":"2024-05-24","highlight":{"excerpt":"本院台灣民眾黨黨團，為透過科技偵查手段有效打擊犯罪，配合通訊保障及監察法增設執法機關調取網路流量紀錄之修正，有必要同步修法課予電信事業及設置公眾電信網路者保存網路流量紀錄之義務，爰擬具「電信管理法第九條及第四十條條文修正草案」。","terms":["科技","通訊","網路","電信"],"cut":[false,false]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110050360000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/15/LCEWA01_110115_00071.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110037700000","activity":"bill_primary","title":"「電信管理法第五條及第八條之一條文修正草案」，請審議案。","meeting":"第11屆第1會期第11次會議","date":"2024-04-26","highlight":{"excerpt":"經查電信詐騙經常透過二類電信取得詐騙門號，惟於原本電信法受政府直接規範採登記制之二類電信，於現今電信管理法下卻毋須登記，所受之監管密度亦大幅降低，甚至將防詐責任推予一類電信業者，與全民呼籲打擊詐騙之民意相悖。","terms":["電信"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110037700000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/11/LCEWA01_110111_00154.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110067460000","activity":"bill_primary","title":"「人工智慧發展及管理條例草案」，請審議案。","meeting":"第11屆第2會期第1次會議","date":"2024-09-20","highlight":{"excerpt":"為使人工智慧管制能有效管理，避免人工智慧成為侵害人民基本權的系統，並以建立「可信賴之人工智慧」為基礎促進人工智慧之發展，爰擬具「人工智慧發展及管理條例草案」。","terms":["人工智慧"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110067460000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/01/LCEWA01_110201_00025.pdf","printed_pages":null}]},{"person_id":"ly1261","year":2024,"event_id":"bill:202110050370000","activity":"bill_primary","title":"「通訊保障及監察法部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第15次會議","date":"2024-05-24","highlight":{"excerpt":"配合同步修正刑事訴訟法增設「科技偵查」專章，有必要於通訊保障及監察法另增訂執法機關調取網路流量紀錄之規範，爰擬具「通訊保障及監察法部分條文修正草案」。","terms":["科技","通訊","網路"],"cut":[false,false]},"hits":4,"l