inal/pdf/110/87/LCIDC01_1108701.pdf","printed_pages":"207-280"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/132569","printed_pages":null}]},{"person_id":"ly1237","year":2021,"event_id":"speech:b2a7c0a35c897b34","activity":"speech","title":"第10屆第3會期教育及文化委員會第7次全體委員會議","meeting":"第10屆第3會期教育及文化委員會第7次全體委員會議","date":"2021-03-31","highlight":{"excerpt":"關於全民國防，我是外交及國防委員會的委員，我在質詢國防部部長的時候，他表示全民國防跟各個部會應該都有關係；我詢問退輔會主委同樣的問題，他甚至提出一個提議，就是希望退輔會裡面有從軍經驗的同仁可以派任至各個部會達成全民國防的任務，因為其他部會的","terms":["國防","國防部","退輔會"],"cut":[false,true]},"hits":10,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/110/41/LCIDC01_1104101.pdf","printed_pages":"55-150"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/110/41/LCIDC01_1104101.pdf","printed_pages":"55-150"}]},{"person_id":"ly1237","year":2021,"event_id":"speech:c2b53714383a98df","activity":"speech","title":"第10屆第3會期第1次臨時會第1次會議","meeting":"第10屆第3會期第1次臨時會第1次會議","date":"2021-06-07","highlight":{"excerpt":"所有的陳情都出自對國防部的不信任，院長，我認為你有這個責任來協調國防部及衛福部來把這些東西的管道弄好，國防部後面退輔會有榮總等等，國防部自己有軍醫局，這應該都是有相當的知識及道德涵養，應該可以把這些東西顧好，不是發生一件就處理一件，尤其是去","terms":["國防","國防部","退輔會"],"cut":[false,true]},"hits":9,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/110/69/LCIDC01_1106901.pdf","printed_pages":"3-92"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/110/69/LCIDC01_1106901.pdf","printed_pages":"3-92"}]},{"person_id":"ly1237","year":2021,"event_id":"speech:8c5881fdd76c36cc","activity":"speech","title":"第10屆第3會期司法及法制、外交及國防委員會第3次聯席會議","meeting":"第10屆第3會期司法及法制、外交及國防委員會第3次聯席會議","date":"2021-05-03","highlight":{"excerpt":"在全面意識上面，我認為安全威脅以及新型態防護，甚至認知做戰這些事情，本來就是全民國防的一部分，上一次在質詢時，你也特別提到，並認同我的講法，我認為這不存在政治鬥爭或是任何意義，而是在保衛所謂中華民國國土的前提之下，我們應該要建立跟對岸不同的","terms":["國防"],"cut":[true,true]},"hits":9,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/110/56/LCIDC01_1105601.pdf","printed_pages":"187-230"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/110/56/LCIDC01_1105601.pdf","printed_pages":"187-230"}]}],"health":[{"person_id":"ly1237","year":2021,"event_id":"bill:1100408070200100","activity":"bill_primary","title":"「獸醫師法第二條之一及第三十條條文修正草案」，請審議案。","meeting":"第10屆第3會期第8次會議","date":"2021-04-16","highlight":{"excerpt":"本院委員蘇巧慧、羅致政、林楚茵、陳柏惟、賴惠員、林俊憲等21人，鑒於國人飼養伴侶動物風氣日漸興盛，動物醫療之需求隨之增多，有設置動物醫事助理以協助獸醫師執行醫療診治行為之必要，爰擬具「獸醫師法第二條之一及第三十條條文修正草案」。","terms":["醫療","醫事","醫師"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1100408070200100/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/03/08/LCEWA01_100308_00019.pdf","printed_pages":null}]},{"person_id":"ly1237","year":2020,"event_id":"bill:1090521070200400","activity":"bill_primary","title":"「職能治療師法增訂第十二條之一條文草案」，請審議案。","meeting":"第10屆第1會期第15次會議","date":"2020-05-29","highlight":{"excerpt":"本院委員陳柏惟等18人，為提供民眾職能治療服務之可近性，除醫療照護領域職能治療外，更拓展教育、健康維持、預防延緩失能、交通、勞政及社會福利（如輔具及無障礙環境評估）等非以治療疾病為目的之專業服務，俾使提升國民健康，增進民眾福祉。","terms":["治療","醫療"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1090521070200400/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/01/15/LCEWA01_100115_00023.pdf","printed_pages":null}]},{"person_id":"ly1237","year":2020,"event_id":"bill:1090410070201100","activity":"bill_primary","title":"「全民健康保險法第十八條及第二十三條條文修正草案」，請審議案。","meeting":"第10屆第1會期第10次會議","date":"2020-04-24","highlight":{"excerpt":"本院委員莊競程、邱志偉、莊瑞雄、陳柏惟等18人，鑑於非本國國籍者使用健保時，恐排擠本國國民之醫療資源，有違「全民健康保險法」第一條，服務國民之立法目的，爰擬具「全民健康保險法第十八條及第二十三條條文修正草案」。","terms":["健保","醫療"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1090410070201100/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/01/10/LCEWA01_100110_00012.pdf","printed_pages":null}]},{"person_id":"ly1237","year":2020,"event_id":"bill:1090330070202800","activity":"bill_primary","title":"「全民健康保險法部分條文修正草案」，請審議案。","meeting":"第10屆第1會期第8次會議","date":"2020-04-10","highlight":{"excerpt":"，鑑於「全民健康保險法」第十條第一項第六款之二目分類，其規範之被保險人經濟能力及使用健保資源等明顯不同，避免保險主管機關濫權放寬健康保險費率計算方式，影響健保財政平衡，爰擬具「全民健康保險法部分條文修正草案」，將第六款第二目獨立劃為第七類。","terms":["健保"],"cut":[true,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1090330070202800/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/01/08/LCEWA01_100108_00014.pdf","printed_pages":null}]},{"person_id":"ly1237","year":2020,"event_id":"bill:1090423070201600","activity":"bill_primary","title":"「老人福利法第二十五條條文修正草案」，請審議案。","meeting":"第10屆第1會期第11次會議","date":"2020-05-01","highlight":{"excerpt":"隨我國少子女化現象日趨嚴重，整體人口結構快速趨向高齡化，使得長期照顧需求人數也同步增加。","terms":["長期照顧"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1090423070201600/details","printed_pages":null}]}],"international":[{"person_id":"ly1237","year":2020,"event_id":"bill:1091214070201600","activity":"bill_primary","title":"「臺灣地區與大陸地區人民關係條例部分條文修正草案」，請審議案。","meeting":"第10屆第2會期第8次會議","date":"2020-12-18","highlight":{"excerpt":"ernization Act of 2018）強化外資審查；2019年3月21日歐盟也公告「歐盟外人直接投資監督架構」，對外人在歐盟之投資建立更完善透明的審查機制，同時對於「公共安全」、「國家利益」、「關鍵技術」等議題提供清楚且公開之定義。","terms":["歐盟"],"cut":[true,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1091214070201600/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/10/02/08/LCEWA01_100208_00050.pdf","printed_pages":null}]},{"person_id":"ly1237","year":2021,"event_id":"bill:1100428070201600","activity":"bill_primary","title":"「資恐防制法第一條、第四條及第五條條文修正草案」，請審