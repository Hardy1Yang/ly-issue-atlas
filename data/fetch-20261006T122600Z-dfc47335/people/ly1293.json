nda1/02/pdf/11/02/15/LCEWA01_110215_00207.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110083070000","activity":"bill_primary","title":"廢止「教育部體育署組織法」，請審議案。","meeting":"第11屆第2會期第15次會議","date":"2024-12-27","highlight":{"excerpt":"本院委員葉元之、廖偉翔等21人，鑒於教育部體育署將升格為體育暨運動發展部，原由教育部體育署所職掌之全國運動及體育發展相關事務，將全數轉移至體育暨運動發展部掌管，配合組織改造，教育部體育署組織法已無存在之必要。","terms":["體育"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110083070000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/15/LCEWA01_110215_00009.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110084640000","activity":"bill_primary","title":"「國軍眷村文化保存暨發展條例草案」，請審議案。","meeting":"第11屆第2會期第17次會議","date":"2025-01-10","highlight":{"excerpt":"為永續保存並活化眷村文化資產，傳承其特殊歷史風貌，加速推動文化資產保存與發展，爰擬具「國軍眷村文化保存暨發展條例草案」，以落實保存、活化及永續發展之目標。","terms":["文化","文化資產"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110084640000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/17/LCEWA01_110217_00009.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110084080000","activity":"bill_primary","title":"「國民體育法第二十二條條文修正草案」，請審議案。","meeting":"第11屆第2會期第16次會議","date":"2025-01-03","highlight":{"excerpt":"本院委員葉元之等19人，有鑑於現行運動選手職涯輔導機制僅針對績優選手，對其他選手退役後之多元職涯需求支援不足，且輔導政策以體育相關職業為主，難以全面覆蓋選手或發展多元專業技能之需求。","terms":["選手","體育"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110084080000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/16/LCEWA01_110216_00009.pdf","printed_pages":null}]}],"education":[{"person_id":"ly1293","year":2025,"event_id":"bill:202110183000000","activity":"bill_primary","title":"「國民轉介教育條例草案」，請審議案。","meeting":"第11屆第4會期第17次會議","date":"2026-01-09","highlight":{"excerpt":"本院委員葉元之等19人，鑑於現行國民教育階段，對於在學學生出現嚴重適應困難、行為偏差顯著造成師生安全疑慮「校園小霸王」，學校輔導資源難以有效介入，且其行為持續嚴重影響學校正常教學秩序與多數學生之學習權益，甚至危及其他師生生命安全，爰擬具「國","terms":["教育","學生","學校","教學"],"cut":[false,true]},"hits":16,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110183000000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/17/LCEWA01_110417_00011.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110069010000","activity":"bill_primary","title":"「教育經費編列與管理法第三條條文修正草案」，請審議案。","meeting":"第11屆第2會期第4次會議","date":"2024-10-11","highlight":{"excerpt":"為確保我國幼兒教育、國民教育、高等教育等各階段教育實施所需之經費來源穩定，並且提升整體教育品質，實有必要修訂提高教育預算投入比例之法源依據，爰擬具「教育經費編列與管理法第三條條文修正草案」，將各級政府教育經費預算合計應不低於該年度預算籌編時","terms":["教育","高教"],"cut":[false,true]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110069010000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/04/LCEWA01_110204_00012.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2025,"event_id":"bill:202110097510000","activity":"bill_primary","title":"「教育基本法第二條條文修正草案」，請審議案。","meeting":"第11屆第3會期第6次會議","date":"2025-03-21","highlight":{"excerpt":"本院委員葉元之等18人，鑒於教育應具備培養國民健全人格、民主素養、法治觀念、人文涵養、愛國教育、鄉土關懷、資訊知能、強健體魄等多元目標，且108課綱亦將哲學中之思辨教育、價值思辨納入課程中，爰擬具「教育基本法第二條條文修正草案」，將「哲學」","terms":["教育","國教","課綱"],"cut":[false,true]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110097510000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/06/LCEWA01_110306_00025.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110081020000","activity":"bill_primary","title":"「教育部組織法第二條、第五條及第九條條文修正草案」，請審議案。","meeting":"第11屆第2會期第12次會議","date":"2024-12-06","highlight":{"excerpt":"徐巧芯、葉元之、陳菁徽等17人，鑒於行政院增設運動部，並依此調整相關職責，原本由教育部體育署負責的運動教育、全民運動、競技運動、運動產業、國際與兩岸運動及運動設施政策規劃、輔導及行政監督等事項，將轉交運動部辦理；而學校體育相關業務，包括十二","terms":["教育部","教育","學校"],"cut":[true,true]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110081020000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/15/LCEWA01_110215_00166.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110077670000","activity":"bill_primary","title":"「教師待遇條例第二十條條文修正草案」，請審議案。","meeting":"第11屆第2會期第10次會議","date":"2024-11-22","highlight":{"excerpt":"然考量教師待遇審議攸關教師薪資調整，為確保基層教師意見有效傳達，以符民主、溝通之原則，並讓第一線教師確實了解政府在薪資調整上之考量，對於審議軍公教待遇薪資福利之相關會議，應納入同級教師組織、團體代表，俾利雙向溝通，並為安定教師生活，激勵教學","terms":["教師","教學"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110077670000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/10/LCEWA01_110210_00009.pdf","printed_pages":null}]}],"law_crime":[{"person_id":"ly1293","year":2024,"event_id":"bill:202110033940000","activity":"bill_primary","title":"「中華民國刑法第三百三十九條及第三百三十九條之四條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院委員葉元之、廖偉翔、張嘉郡、羅廷瑋、蘇清泉等24人，鑑於當前詐欺犯罪案與日俱增，犯罪手法多元且朝科技化、集團化、組織化等結構性犯罪發展，致使民眾生命財產安全受到嚴重威脅，更對社會造成負面影響，導致嚴重負外部性，使社會福祉減少及我國國際形","terms":["詐欺","犯罪"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110033940000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00133.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110072020000","activity":"bill_primary","title":"「性侵害犯罪防治法增訂第三十二條之一條文草案」，請審議案。","meeting":"第11屆第2會期第6次會議","date":"2024-10-25","highlight":{"excerpt":"本院委員徐巧芯、廖偉翔、黃健豪、牛煦庭、葉元之等16人，為杜絕對幼童實施性侵害犯罪者及被起訴之嫌疑人能夠從犯罪縣市轉移至其他地方持續擔任，或受聘於實施犯罪行為之相同或類似職務，爰擬具「性侵害犯罪防治法增訂第三十二條之一條文草案」。","terms":["犯罪"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110072020000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/06/LCEWA01_110206_00026.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110061430000","activity":"bill_primary","title":"「性侵害犯罪防治法第五十二條條文修正草案」，請審議案。","meeting":"第11屆第1會期第22次會議","date":"2024-07-12","highlight":{"excerpt":"為此，爰擬具「性侵害犯罪防治法第五十二條條文修正草案」，要求公布判決確定且具再犯之虞者之性犯罪者姓名與照片，提高社會透明度與增加社會監督力量，進而達到減少性犯罪再犯率，降低社會成本。","terms":["犯罪","判決"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110061430000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/22/LCEWA01_110122_00028.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110086660000","activity":"bill_primary","title":"「中華民國刑法增訂第八十九條之一條文草案」，請審議案。","meeting":"第11屆第2會期第18次會議","date":"2025-01-17","highlight":{"excerpt":"本院委員葉元之等20人，鑒於酒駕再犯嚴重，成為影響交通安全與社會秩序之重大治安事件，儘管多次修訂「道路交通管理處罰條例」及刑法相關規定，強化罰責與執法，但遏止效果有限。","terms":["治安","刑法"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110086660000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/18/LCEWA01_110218_00038.pdf","printed_pages":null}]},{"person_id":"ly1293","year":2024,"event_id":"bill:202110061440000","activity":"bill_primary","title":"「國家通訊傳播委員會組織法第四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第22次會議","date":"2024-07-12","highlight":{"excerpt":"參考其他部會與機關組織法，如考試院及監察院等以及大法官，相關機關之委員在立法院不同意的情況下均無法繼續連任。","terms":["法官","法院"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110061440000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/22/LCEWA01_110122_00029.pdf","printed_pages":null}]}],"technolo