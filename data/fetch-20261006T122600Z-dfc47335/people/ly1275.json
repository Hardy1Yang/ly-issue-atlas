,"eventual_count":8,"undated_count":0,"bills":74},{"year":2025,"stage":"flow_unknown","as_of":"2026-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":74}],"records":{"education":[{"person_id":"ly1275","year":2024,"event_id":"bill:202110084810000","activity":"bill_primary","title":"廢止「教育部體育署組織法」，請審議案。","meeting":"第11屆第2會期第17次會議","date":"2025-01-10","highlight":{"excerpt":"本院委員翁曉玲、羅廷瑋等16人，有鑑於教育部體育署將升格為體育暨運動發展部，原由教育部體育署所職掌之全國運動及體育發展相關事務，將全數轉移至體育暨運動發展部掌管，依《中央法規標準法》第二十一條之規定，教育部體育署組織法已無存在之必要，待運動","terms":["教育部","教育"],"cut":[false,true]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110084810000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/17/LCEWA01_110217_00022.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110068560000","activity":"bill_primary","title":"「教育經費編列與管理法第三條條文修正草案」，請審議案。","meeting":"第11屆第2會期第3次會議","date":"2024-10-04","highlight":{"excerpt":"本院委員徐欣瑩、謝龍介、翁曉玲、楊瓊瓔、羅廷瑋、林沛祥等29人，有鑑於我國教育經費占GDP比率持續下滑，且水、電費等費率持續上漲，為保障我國教育品質，爰擬具「教育經費編列與管理法第三條條文修正草案」，將第三條現行法定教育經費下限調高為「合計","terms":["國教","教育"],"cut":[false,true]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110068560000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/03/LCEWA01_110203_00045.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2025,"event_id":"bill:202110087470000","activity":"bill_primary","title":"「教育經費編列與管理法第三條條文修正草案」，請審議案。","meeting":"第11屆第3會期第2次會議","date":"2025-02-25","highlight":{"excerpt":"本院委員翁曉玲等18人，有鑑於教育不僅是國家的根本，更是國家競爭力的基石，惟近年通膨嚴重、物價飛漲，據教育部統計，近年來我國教育經費占GDP比率持續下滑，2023年度教育經費GDP占比僅剩4.26%，為自1981年以來最低，對比世界各國更是","terms":["教育","教育部","國教"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110087470000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/02/LCEWA01_110302_00012.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2025,"event_id":"bill:202110147500000","activity":"bill_primary","title":"「大學法第七條條文修正草案」，請審議案。","meeting":"第11屆第3會期第23次會議","date":"2025-08-01","highlight":{"excerpt":"現行法僅規定國立大學之合併須經校務會議同意，然同為公立之直轄市立、縣（市）立大學卻僅須經地方政府同意，而未設有尊重學校校內意見之機制，故增訂其合併亦應經過校務會議同意後始得為之。","terms":["大學","校務","學校"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110147500000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/23/LCEWA01_110323_00009.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110079660000","activity":"bill_primary","title":"「偏遠地區學校教育發展條例第五條條文修正草案」，請審議案。","meeting":"第11屆第2會期第11次會議","date":"2024-11-29","highlight":{"excerpt":"配合該法修正草案之提出比照育嬰留職停薪期間，偏遠地區學校編制內合格專任教師於育孫而留職停薪期間之年資，得採計至多二年之規定，爰擬具「偏遠地區學校教育發展條例第五條條文修正草案」。","terms":["學校","任教","教師","教育"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110079660000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/11/LCEWA01_110211_00022.pdf","printed_pages":null}]}],"government":[{"person_id":"ly1275","year":2024,"event_id":"bill:202110070670000","activity":"bill_primary","title":"「考試院組織法第七條、第十條及第十一條條文修正草案」，請審議案。","meeting":"第11屆第2會期第5次會議","date":"2024-10-18","highlight":{"excerpt":"本院委員翁曉玲等16人，有鑑於考試委員為考試院院會之主體，憲法所定考試院職掌之政策及其有關重大事項，應由考試委員共同行使，考選部、銓敘部、保訓會作為考試院之下級機關，其主管應列席院會配合協助考試委員行使職權；考試院會議規則及處務規程應送立法","terms":["考試院","憲法","銓敘"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110070670000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/05/LCEWA01_110205_00011.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2025,"event_id":"bill:202110182840000","activity":"bill_primary","title":"「公民投票法第十五條條文修正草案」，請審議案。","meeting":"第11屆第4會期第16次會議","date":"2026-01-02","highlight":{"excerpt":"基於代議制度係間接民權之實踐，立法院公投提案權，當不限於憲法規定提出之複決案及重大政策之創制或複決案，若立法院就攸關立法之重要事項，認有提出公民投票之必要者，經立法院院會通過後，交付公民投票，具強化立法的民主正當性之實益，主管機關不得拒絕，","terms":["公投","憲法","複決","創制"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110182840000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/16/LCEWA01_110416_00126.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110060440000","activity":"bill_primary","title":"「憲法訴訟法第四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第21次會議","date":"2024-07-05","highlight":{"excerpt":"惟現行憲法訴訟法未明定大法官現有總額定義，僅規定迴避之大法官，不計入現有總額之人數，恐出現僅三、四位大法官即形成多數意見而作成判決之極端情形發生，不符合前揭憲法增修條文規定大法官法定人數十五人之宗旨。","terms":["憲法","大法官"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110060440000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/21/LCEWA01_110121_00032.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110047290000","activity":"bill_primary","title":"「監察委員行為法草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","highlight":{"excerpt":"惟監察委員並未如立法委員受立法委員行為法、公職人員利益衝突迴避法與公職人員財產申報法之規範，致其身為監察機關卻不受相應之法律規範監督，爰參考上開法律與監察院監察委員自律規範，爰擬具「監察委員行為法草案」。","terms":["監察委員","公職","監察院"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110047290000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/14/LCEWA01_110114_00060.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110010520000","activity":"bill_primary","title":"「總統副總統選舉罷免法部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第4次會議","date":"2024-03-08","highlight":{"excerpt":"然依現行總統副總統選舉罷免法第六十三條規定：「選舉結果以候選人得票最多之一組為當選」，係採相對多數一輪投票制，故其中一組候選人得票數高於其他組候選人，而不論其是否得到過半數同意，即屬當選。","terms":["選舉","罷免","候選"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110010520000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/04/LCEWA01_110104_00034.pdf","printed_pages":null}]}],"law_crime":[{"person_id":"ly1275","year":2025,"event_id":"bill:202110162680000","activity":"bill_primary","title":"「法院組織法第八十三條條文修正草案」，請審議案。","meeting":"第11屆第4會期第4次會議","date":"2025-10-14","highlight":{"excerpt":"本院委員翁曉玲等18人，為保障人民知的權利，加強對檢察官履行法定性義務及客觀性義務之監督，檢察官於案件偵查終結後，應公開起訴書、聲請簡易處刑書、不起訴處分書及緩起訴處分書等檢察書類，俾透過資訊之透明化，藉以檢視檢察官偵查品質，並強化社會公眾","terms":["檢察官","檢察","偵查"],"cut":[false,true]},"hits":14,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110162680000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/04/LCEWA01_110404_00008.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110018440000","activity":"bill_primary","title":"「更生保護法第十一條條文修正草案」，請審議案。","meeting":"第11屆第1會期第7次會議","date":"2024-03-29","highlight":{"excerpt":"近年來，我國已分別修正《少年事件處理法》、《刑事訴訟法》、《監獄行刑法》及《犯罪被害人權益保障法》，從少年事件到成人犯罪之偵查、審理及執行階段均可轉介修復，顯示我國對於修復式司法在犯罪預防功能上之肯定，惟美中不足者，獨漏刑事司法預防犯罪末端","terms":["刑事","監獄","刑法","犯罪","偵查","審理","司法"],"cut":[false,true]},"hits":12,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110018440000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/07/LCEWA01_110107_00015.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2025,"event_id":"bill:202110162690000","activity":"bill_primary","title":"「刑事訴訟法第一百零八條條文修正草案」，請審議案。","meeting":"第11屆第4會期第4次會議","date":"2025-10-14","highlight":{"excerpt":"惟現行《刑事訴訟法》第一百零八條「羈押被告，偵查中不得逾二月」、「審判中不得逾三月」及相關延長羈押之規定，可能造成司法機關動輒「押人取供」，導致「羈押刑罰化」，為保障犯罪嫌疑人或被告之人權，故有縮短偵查及審判羈押期限之必要。","terms":["刑事","羈押","偵查","審判","司法","犯罪"],"cut":[false,false]},"hits":11,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110162690000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/04/LCEWA01_110404_00009.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2025,"event_id":"bill:202110157150000","activity":"bill_primary","title":"「詐欺犯罪危害防制條例第四十六條及第四十七條條文修正草案」，請審議案。","meeting":"第11屆第3會期第27次會議","date":"2025-08-29","highlight":{"excerpt":"本院委員翁曉玲、廖偉翔等24人，有鑑於詐欺被告自首、自白並繳交犯罪所得減刑或免除其刑之規定，於刑事大法庭113年度台上大字第4096號刑事裁定後，詐欺被告自首、自白後，僅須繳回實際報酬即可輕鬆減刑，縱無實際報酬亦合於減刑要件，有司法輕判縱放","terms":["詐欺","犯罪","刑事","司法"],"cut":[false,true]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110157150000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/27/LCEWA01_110327_00023.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110031710000","activity":"bill_primary","title":"「軍事審判法第三十四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"本院委員翁曉玲、陳永康、徐巧芯等16人，鑑於現役軍人涉犯陸海空軍刑法及其特別法之罪，在戰時為維護軍事利益，本應依軍事審判法追訴；惟現行軍事審判法第三十四條規定「犯罪事實之一部應依刑事訴訟法追訴、審判時，全部依刑事訴訟法追訴、審判之。","terms":["刑法","審判","犯罪","刑事"],"cut":[false,false]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110031710000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00033.pdf","printed_pages":null}]}],"technology":[{"person_id":"ly1275","year":2024,"event_id":"bill:202110027190000","activity":"bill_primary","title":"「國家通訊傳播委員會組織法第四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第8次會議","date":"2024-04-09","highlight":{"excerpt":"為維護通訊傳播自由和提升通傳會作為獨立機關的獨立性，爰參考美國聯邦通訊傳播委員會、韓國通訊傳播委員會及法國視聽與數位通訊監管局等機關組成方式，修正國家通訊傳播委員會組織法第四條有關委員會之組成，降低單一政黨對通傳會之影響，包括減少通傳會委員","terms":["通訊","通傳會","數位"],"cut":[false,true]},"hits":10,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110027190000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/08/LCEWA01_110108_00070.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110057210000","activity":"bill_primary","title":"「通訊保障及監察法第十五條及第十九條條文修正草案」，請審議案。","meeting":"第11屆第1會期第20次會議","date":"2024-06-28","highlight":{"excerpt":"本院委員羅智強、謝龍介、翁曉玲、林沛祥等16人，鑑於對人民秘密通訊自由權益之保護，避免政府調取人民通信紀錄與網路流量紀錄時，被調取人無從獲知被調取行為，致使無從進行救濟，以及明定違法調取應負損害賠償責任，保障人民秘密通訊自由及隱私權不受非法","terms":["通訊","網路"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110057210000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/22/LCEWA01_110122_00482.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110055350000","activity":"bill_primary","title":"「衛星廣播電視法部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第18次會議","date":"2024-06-14","highlight":{"excerpt":"另，近來主管機關國家通訊傳播委員會對衛廣事業之申設、評鑑、換照和營運管理等行政措施屢屢引發爭議，不僅斲傷獨立機關專業客觀之公正性，對通訊傳播產業健全發展造成妨礙，且嚴重影響消費者收視與選擇之權益，爰擬具「衛星廣播電視法部分條文修正草案」，鬆","terms":["通訊","衛星"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110055350000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/18/LCEWA01_110118_00018.pdf","printed_pages":null}]},{"person_id":"ly1275","year":2024,"event_id":"bill:202110047160000","activity":"bill_primary","title":"「國家通訊傳播委員會組織法第四條及第五條條文修正草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","highlight":{"excerpt":"政治化或充分顧及政治與社會多元價值而設立，然基於權力分立原則，立法院對行政院有關通訊傳播會（下稱通傳會）委員之人事決定權得以同意權之形式以為制衡，為貫徹責任政治及立法權制衡之相關法理，若通傳會之委員任期屆滿後，自應當然解任，不宜因其他因素而","terms":["通訊","通傳會"],"cut":[true,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110047160000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1