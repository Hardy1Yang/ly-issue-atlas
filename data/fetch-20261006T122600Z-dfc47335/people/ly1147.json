{"year":2016,"stage":"scheduled","as_of":"2017-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":21},{"year":2016,"stage":"flow_unknown","as_of":"2017-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":21}],"records":{"civil_rights":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050314070200300","activity":"bill_primary","title":"「大眾捷運法第五十條條文修正草案」，請審議案。","meeting":"第9屆第1會期第5次會議","date":"2016-03-18","highlight":{"excerpt":"本院委員鄭麗君、蔡適應、葉宜津、李昆澤、林俊憲等31人，為保障身心障礙者權益、增進身心障礙人士之自由行動及獨立生活之能力、維護身心障礙者日常起居需求，爰提出大眾捷運法第五十條條文修正草案。","terms":["身心障礙","障礙者"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050314070200300/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/05/LCEWA01_090105_00107.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050314070200400","activity":"bill_primary","title":"「鐵路法第七十一條條文修正草案」，請審議案。","meeting":"第9屆第1會期第5次會議","date":"2016-03-18","highlight":{"excerpt":"本院委員鄭麗君、蔡適應、葉宜津、李昆澤、林俊憲等29人，為完整保障身心障礙者之權益，同時增進身心障礙人士之自由行動與獨立生活之能力、並考量身心障礙者日常起居需求，爰提出鐵路法第七十一條條文修正草案。","terms":["身心障礙","障礙者"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050314070200400/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/05/LCEWA01_090105_00108.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050225070201700","activity":"bill_primary","title":"「集會遊行法修正草案」，請審議案。","meeting":"第9屆第1會期第3次會議","date":"2016-03-04","highlight":{"excerpt":"爰擬具「集會遊行法」修正草案，同時更正法律名稱為「集會遊行保障法」，重新界定主管機關，明確化國家保障集會遊行之義務，廢除許可制、改採自願報備制，並廢除禁制區之限制及命令解散之制度等。","terms":["集會遊行"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050225070201700/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/03/LCEWA01_090103_00020.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"speech:17ee54537e9f1c31","activity":"speech","title":"第9屆第1會期交通委員會第9次全體委員會議","meeting":"第9屆第1會期交通委員會第9次全體委員會議","date":"2016-04-25","highlight":{"excerpt":"依照聯合國經社文委員會第五號一般性意見，若是國家以身心障礙為由，導致身心障礙者無法受到一般人所受之相同待遇，這種行為應視為對身心障礙者的歧視，所以我們應該盡量消弭這樣的歧視，本國在103年12月3日已經開始施行身心障礙者權利公約施行法，施行","terms":["身心障礙","障礙者","歧視"],"cut":[false,true]},"hits":11,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/31/LCIDC01_1053101.pdf","printed_pages":"1-66"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:ac5d174e42b5742c","activity":"speech","title":"第9屆第1會期內政委員會第14次全體委員會議","meeting":"第9屆第1會期內政委員會第14次全體委員會議","date":"2016-05-09","highlight":{"excerpt":"我來稍微整理一下，我們現在是改成集會遊行保障法，然後分兩部分討論，所以你們不要一直去想怎麼樣納入管理，現在是改為集會遊行保障法，然後要處理報備、請求協助及所需檢附的文件，這部分是屬於保障對象，就是哪些情況、哪些人會列入集會遊行保障的對象，它","terms":["集會遊行"],"cut":[false,true]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/38/LCIDC01_1053801.pdf","printed_pages":"405-470"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/38/LCIDC01_1053801.pdf","printed_pages":"471-516"}]}],"culture":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050325070202100","activity":"bill_primary","title":"「文化資產保存法部分條文修正草案」，請審議案。","meeting":"第9屆第1會期第8次會議","date":"2016-04-08","highlight":{"excerpt":"本院委員鄭麗君、蔡培慧、張廖萬堅等26人，有鑑於文化資產保存法現行條文，於執行時仍有其不足，如未考慮特定性質之行政機關（構）就維護其所有或所管理之文化資產有其結構性困難；行政機關（構）依憲法與文化資產保存法有保存文化資產之責任，但相關法令就","terms":["文化","文化資產"],"cut":[false,true]},"hits":18,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050325070202100/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/08/LCEWA01_090108_00025.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050325070201900","activity":"bill_primary","title":"「文化資產保存法第五條條文修正草案」，請審議案。","meeting":"第9屆第1會期第8次會議","date":"2016-04-08","highlight":{"excerpt":"為之主管機關與規範客體間，應有相當法律上距離，以確保法律執行之有效性與公平性，惟文化資產保存法雖有指定、登錄與處罰等管制性政策工具，卻未設地方自治團體身兼管制機關與開發單位時，管制措施移轉中央之機制，顯有未妥；矧就文化資產保存實務而言，近年","terms":["文化","文化資產"],"cut":[true,true]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050325070201900/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/08/LCEWA01_090108_00024.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"speech:7f13bd88b094802a","activity":"speech","title":"第9屆第1會期教育及文化委員會第9次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第9次全體委員會議","date":"2016-03-28","highlight":{"excerpt":"過去長期以來，故宮人可能會有職業驕傲，也可能因為文物歸他們所管就誤認文物是故宮所有的，當然也許近年來沒有這樣的情況了，但是我們要矯正這樣的觀念，為什麼過去屢屢發生侵權行為時，故宮都不積極，我們一直堅持故宮文物是國家文物，被侵權時，其衍生商品","terms":["故宮","文物"],"cut":[false,true]},"hits":8,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/18/LCIDC01_1051801.pdf","printed_pages":"109-158"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/18/LCIDC01_1051801.pdf","printed_pages":"109-158"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:58689fc5ed0c993e","activity":"speech","title":"第9屆第1會期教育及文化委員會第6次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第6次全體委員會議","date":"2016-03-14","highlight":{"excerpt":"院長，我們都知道博物館最基本的四大功能是典藏、展示、推廣和研究，尤其是典藏，因為它決定了整個館的豐富和特殊性，所以很多委員對於保存文物一再的關心，這是故宮最基本的責任，我們每年在審預算也會關心你們關於溫濕度等管控，尤其是大部分文物都需要有溫","terms":["博物館","典藏","文物","故宮"],"cut":[false,true]},"hits":6,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/11/LCIDC01_1051101.pdf","printed_pages":"353-444"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/11/LCIDC01_1051101.pdf","printed_pages":"287-352"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:97236a264a672397","activity":"speech","title":"第9屆第1會期第4次會議","meeting":"第9屆第1會期第4次會議","date":"2016-03-11","highlight":{"excerpt":"最後，本席一直關心臺北機場被全區指定，也責成文化部要推動交通博物館，但這個計畫行政院要文化部編列401億預算向臺鐵購買土地！","terms":["文化部","文化","博物館"],"cut":[false,false]},"hits":5,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/04/LCIDC01_1050401.pdf","printed_pages":"149-159"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/04/LCIDC01_1050401.pdf","printed_pages":"149-159"}]}],"education":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050325070202000","activity":"bill_primary","title":"「高級中等教育法部分條文修正草案」，請審議案。","meeting":"第9屆第1會期第8次會議","date":"2016-04-08","highlight":{"excerpt":"為保障高級中等教育階段學生參與校務會議之權利，並確保學生能夠參與攸關個人權利之相關獎懲規定之制定過程及個案評議程序，爰提出高級中等教育法部分條文修正草案。","terms":["教育","學生","校務"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050325070202000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/08/LCEWA01_090108_00023.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050408070200400","activity":"bill_primary","title":"「高級中等教育法第六十七條條文修正草案」，請審議案。","meeting":"第9屆第1會期第9次會議","date":"2016-04-15","highlight":{"excerpt":"「高級中等教育法第六十七條條文修正草案」，請審議案。","terms":["教育"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050408070200400/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/09/LCEWA01_090109_00063.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"speech:91641fb4e62ae4a9","activity":"speech","title":"第9屆第1會期教育及文化委員會第5次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第5次全體委員會議","date":"2016-03-10","highlight":{"excerpt":"陳委員學聖提的問題完全是兩件事，教育部本來就要有這個預算，而且這件事情本來就應該做，即使520之後重新思考高教5年1,000億的預算，也不可能延緩任何學貸的改革，它本來就是必要做的事情，何況5年1,000億並不是教育部全體預算，不要讓外界產","terms":["教育部","教育","高教","學貸"],"cut":[false,true]},"hits":15,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/09/LCIDC01_1050901.pdf","printed_pages":"1-80"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/09/LCIDC01_1050901.pdf","printed_pages":"1-80"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:64296f0f3ab3fd1f","activity":"speech","title":"第9屆第1會期教育及文化委員會第17次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第17次全體委員會議","date":"2016-05-05","highlight":{"excerpt":"我的版本是教育部應訂定準則，就是教育部一定要制定準則；我的第二項則是學校於訂定學生獎懲規定時要遵循準則，換言之，學校並不一定要訂定學生獎懲規定，但是學校若要訂定必須遵循準則，我的提案精神是這樣。","terms":["教育部","教育","學校","學生"],"cut":[false,false]},"hits":9,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/36/LCIDC01_1053601.pdf","printed_pages":"79-182"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/36/LCIDC01_1053601.pdf","printed_pages":"79-182"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:4cc4880df5aad3ff","activity":"speech","title":"第9屆第1會期教育及文化委員會第2次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第2次全體委員會議","date":"2016-03-07","highlight":{"excerpt":"我們都知道大學法第七條第一項是由學校來發動，校務會議通過之後報教育部核定，第二項是由教育部衡酌高教情況來發動。","terms":["大學","學校","校務","教育部","教育","高教"],"cut":[false,false]},"hits":8,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/05/LCIDC01_1050501.pdf","printed_pages":"69-144"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/05/LCIDC01_1050501.pdf","printed_pages":"69-144"}]}],"government":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050219070203700","activity":"bill_primary","title":"「公職人員選舉罷免法第四十七條條文修正草案」，請審議案。","meeting":"第9屆第1會期第2次會議","date":"2016-02-26","highlight":{"excerpt":"本院委員Kolas Yotaka、蕭美琴、鄭麗君等22人，依中華民國憲法增修條文及原住民族基本法，使具原住民身分之候選人有使用原住民族拼音文字發表政見之權利，爰擬具「公職人員選舉罷免法」第四十七條條文修正草案。","terms":["憲法","候選","公職","選舉","罷免"],"cut":[false,false]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050219070203700/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/02/LCEWA01_090102_00045.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050314070201100","activity":"bill_primary","title":"「公民投票法修正草案」，請審議案。","meeting":"第9屆第1會期第5次會議","date":"2016-03-18","highlight":{"excerpt":"本院委員鄭麗君、鍾佳濱、陳其邁、蔡培慧、莊瑞雄等33人，有鑑於立法院於2003年11月27日三讀通過「公民投票法」，使憲法第十七條及第一百三十六條所定之直接民權，得以回歸由人民行使之規範狀態，並使公民投票之舉辦獲得明確的法源依據。","terms":["憲法"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050314070201100/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/05/LCEWA01_090105_00105.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"speech:ac5d174e42b5742c","activity":"speech","title":"第9屆第1會期內政委員會第14次全體委員會議","meeting":"第9屆第1會期內政委員會第14次全體委員會議","date":"2016-05-09","highlight":{"excerpt":"當時因為是公投入憲，所以要求憲法的修正都必須經過公投，而且憲法增修條文有規定公投的門檻，它跟我們現在要修正的門檻是不一樣的；公投法現行法規定的通過門檻是雙1/2，修憲公投複決的門檻則是同意票為選舉人數的1/2，不止是絕對多數。","terms":["公投","憲法","修憲","複決","選舉"],"cut":[false,false]},"hits":10,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/38/LCIDC01_1053801.pdf","printed_pages":"405-470"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/38/LCIDC01_1053801.pdf","printed_pages":"471-516"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:64296f0f3ab3fd1f","activity":"speech","title":"第9屆第1會期教育及文化委員會第17次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第17次全體委員會議","date":"2016-05-05","highlight":{"excerpt":"我補充蘇委員的意見，她講的也對，A是指經過公開選舉產生或經學生自治組織代表，但是這學生自治組織代表可能是會長，可能不是會長，所以他可能是選舉產生或不是選舉產生，所以當他是會長的時候，他就包含在A，當他不是會長的時候，他就變成是非選舉產生，所","terms":["選舉"],"cut":[false,true]},"hits":8,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/36/LCIDC01_1053601.pdf","printed_pages":"79-182"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/36/LCIDC01_1053601.pdf","printed_pages":"79-182"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:17da756d90d3b36e","activity":"speech","title":"第9屆第1會期內政委員會第11次全體委員會議","meeting":"第9屆第1會期內政委員會第11次全體委員會議","date":"2016-04-27","highlight":{"excerpt":"立法院從2003年11月27日三讀通過公投法，其目的是要讓人民得以行使憲法第十七條及第一百三十六條所定之直接民權，並使公民投票之舉辦有明確的法源依據，但是整個公投法的通過卻設置了諸多不合理的制度性障礙，實質上造成人民受憲法保障之直接民權無法","terms":["公投","憲法"],"cut":[false,true]},"hits":5,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/30/LCIDC01_1053001.pdf","printed_pages":"405-456"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/88105","printed_pages":null}]}],"law_crime":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050509070201400","activity":"bill_primary","title":"「中華民國刑法第三十八條之三條文修正草案」及「中華民國刑法施行法第十條之三條文修正草案」，請審議案。","meeting":"第9屆第1會期第13次會議","date":"2016-05-13","highlight":{"excerpt":"議瑩、林俊憲、吳思瑤、徐國勇、鄭麗君、鍾孔炤等30人，鑑於國家取得沒收標的乃剝奪犯罪利益及阻絕犯罪再發生，基於被害人保護優先及交易安全之維護，因犯罪而得行使債權之第三人，得就國家沒收或追徵所取得之財產，行使其權利以進行分配，以避免其因犯罪行","terms":["犯罪"],"cut":[true,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050509070201400/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/13/LCEWA01_090113_00047.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050325070202300","activity":"bill_primary","title":"「中華民國刑法刪除第一百四十條及第一百四十一條條文草案」，請審議案。","meeting":"第9屆第1會期第8次會議","date":"2016-04-08","highlight":{"excerpt":"本院委員鄭麗君、莊瑞雄、蘇治芬、徐國勇、林靜儀等28人，有鑑於中華民國刑法第一百四十條承襲自舊日本帝國刑法第七十四條以下，與多元民主時代之刑事法思潮相悖，矧就國家法益之保障，妨害公務罪仍置有其他條文，而中華民國刑法第三百零九條以下，就執行職","terms":["刑法","刑事"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050325070202300/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/08/LCEWA01_090108_00027.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050222070202400","activity":"bill_primary","title":"廢止「立法院程序委員會組織規程」，請審議案。","meeting":"第9屆第1會期第2次會議","date":"2016-02-26","highlight":{"excerpt":"為保障本院委員之職權行使與議案提案權，提升本院之議事效率，配合「立法院組織法」，刪除立法院設立程序委員會之相關規定，將立法院議程之安排與提案手續完備之審定交由議事處處理，爰擬具「立法院程序委員會組織規程」廢止案。","terms":["法院"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050222070202400/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/02/LCEWA01_090102_00087.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050222070202300","activity":"bill_primary","title":"「立法院組織法刪除第七條條文草案」，請審議案。","meeting":"第9屆第1會期第2次會議","date":"2016-02-26","highlight":{"excerpt":"為保障本院委員之職權行使與議案提案權，提升本院之議事效率，爰擬具「立法院組織法刪除第七條條文草案」刪除立法院設立程序委員會之相關規定，將立法院議程之安排與提案手續完備之審定交由議事處處理。","terms":["法院"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050222070202300/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/02/LCEWA01_090102_00086.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050219070204900","activity":"bill_primary","title":"「國家安全法第九條條文修正草案」，請審議案。","meeting":"第9屆第1會期第2次會議","date":"2016-02-26","highlight":{"excerpt":"本院委員顧立雄、鄭麗君、尤美女等21人，鑑於現行國家安全法第九條第二款之規定，禁止遭受不當軍事審判之受難者藉由司法程序獲得平復的機會，不當限制人民訴訟權、違反憲法第十六條所保障之人民訴訟權之規範意旨，爰提出國家安全法第九條條文修正草案。","terms":["審判","司法"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050219070204900/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/02/LCEWA01_090102_00057.pdf","printed_pages":null}]}],"transportation":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050311070201600","activity":"bill_primary","title":"「道路交通管理處罰條例第四十五條條文修正草案」，請審議案。","meeting":"第9屆第1會期第6次會議","date":"2016-03-25","highlight":{"excerpt":"本院委員蕭美琴、鄭麗君、徐國勇、賴瑞隆等19人，鑑於汽車駕駛人聞消防車、救護車、警備車、工程救險車、毒性化學物質災害事故應變車之警號，若不立即避讓，而造成相關救護人員或其他人致傷或死亡者，應於行政罰責上為較前項單純擋車不禮讓行為有更加重處罰","terms":["駕駛"],"cut":[false,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050311070201600/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/06/LCEWA01_090106_00020.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050314070200300","activity":"bill_primary","title":"「大眾捷運法第五十條條文修正草案」，請審議案。","meeting":"第9屆第1會期第5次會議","date":"2016-03-18","highlight":{"excerpt":"「大眾捷運法第五十條條文修正草案」，請審議案。","terms":["捷運"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050314070200300/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/05/LCEWA01_090105_00107.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"bill:1050314070200400","activity":"bill_primary","title":"「鐵路法第七十一條條文修正草案」，請審議案。","meeting":"第9屆第1會期第5次會議","date":"2016-03-18","highlight":{"excerpt":"「鐵路法第七十一條條文修正草案」，請審議案。","terms":["鐵路"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050314070200400/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/05/LCEWA01_090105_00108.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"speech:ac5d174e42b5742c","activity":"speech","title":"第9屆第1會期內政委員會第14次全體委員會議","meeting":"第9屆第1會期內政委員會第14次全體委員會議","date":"2016-05-09","highlight":{"excerpt":"以第四款中之「以其他非法方法致道路交通陷於停滯或混亂」為例，所有使用道路面積的遊行都會使交通陷於停滯；而我們的保障法是他可以來報備，你們還要協助他維持交通秩序，兩者豈不相互矛盾？","terms":["道路","交通"],"cut":[false,false]},"hits":5,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/38/LCIDC01_1053801.pdf","printed_pages":"405-470"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/38/LCIDC01_1053801.pdf","printed_pages":"471-516"}]},{"person_id":"ly1147","year":2016,"event_id":"speech:58689fc5ed0c993e","activity":"speech","title":"第9屆第1會期教育及文化委員會第6次全體委員會議","meeting":"第9屆第1會期教育及文化委員會第6次全體委員會議","date":"2016-03-14","highlight":{"excerpt":"而臺鐵局自己財產虧損的問題，七千五百多億的不動產，要不要叫你們來買400億的土地，然後撥出去，請他們跟行政院去協調，讓交通部編錢去處理，不應該占用文化預算。","terms":["臺鐵","交通部","交通"],"cut":[false,false]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/11/LCIDC01_1051101.pdf","printed_pages":"353-444"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/105/11/LCIDC01_1051101.pdf","printed_pages":"287-352"}]}],"unclassified":[{"person_id":"ly1147","year":2016,"event_id":"bill:1050314070200500","activity":"bill_primary","title":"「性別工作平等法第十八條條文修正草案」，請審議案。","meeting":"第9屆第1會期第5次會議","date":"2016-03-18","highlight":null,"hits":0,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/1050314070200500/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/09/01/05/LCEWA01_090105_00109.pdf","printed_pages":null}]},{"person_id":"ly1147","year":2016,"event_id":"speech:ac5d174e42b5742c","activity":"speech","title":"第9屆第1會期內政委員會第14次全體委員會