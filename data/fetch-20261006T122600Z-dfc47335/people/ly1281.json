ks":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/115/09/LCIDC01_1150902.pdf","printed_pages":"417-458"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/166960","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"speech:9366fe1926c442ce","activity":"speech","title":"第11屆第3會期外交及國防委員會第14次全體委員會議","meeting":"第11屆第3會期外交及國防委員會第14次全體委員會議","date":"2025-05-15","highlight":{"excerpt":"我後面幾張圖就用很短的時間跟您講，就是中共的軍演，這是今年3月底跟4月1號中共演習，這是我們的情報次長他用的圖，各位看到就是下面一個很小塊的圖，可是上面的這張圖是一個大型的、涵蓋整個區域的圖，能夠作為一個全區的判斷，這個就是把我們國防部公布","terms":["中共"],"cut":[false,true]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/50/LCIDC01_1145001.pdf","printed_pages":"207-254"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/161406","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"speech:4b22a4d438abaa70","activity":"speech","title":null,"meeting":null,"date":"2024-03-12","highlight":{"excerpt":"、西表島、石垣島，以及美軍最近在巴丹島，還有菲律賓西南，菲律賓最近因為南海問題跟中共在引起爭端的就是中沙群島，我們在內政部的海圖，領海基線把它標註上去的，包括了黃岩島，我們又稱做民主礁，最近並沒有看到我們政府在這上面表達我們的政策跟立場，尤","terms":["中共"],"cut":[true,true]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/06/LCIDC01_1130601.pdf","printed_pages":"99-184"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/06/LCIDC01_1130601.pdf","printed_pages":"99-184"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:1f9516469fe5be5f","activity":"speech","title":"第11屆第4會期外交及國防委員會第22次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第22次全體委員會議","date":"2025-12-17","highlight":{"excerpt":"講到中共在南海跟菲律賓的問題，我特別要強調有關在黃岩島也就是民主礁，中共跟菲律賓因為執法，發生潛在衝突。","terms":["中共"],"cut":[false,false]},"hits":2,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/115/03/LCIDC01_1150301.pdf","printed_pages":"257-320"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/115/03/LCIDC01_1150301.pdf","printed_pages":"257-320"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:e0c2bd4441e3c5e8","activity":"speech","title":"第11屆第4會期外交及國防委員會第17次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第17次全體委員會議","date":"2025-11-24","highlight":{"excerpt":"就是說「臺海有事」是中共出招，「臺灣有事」對中共來講是外力介入，所以應該用「臺海有事」，「臺海」的範疇沒有明確定義，但「臺灣有事」變成屬於管轄權、主權問題，就特別複雜了。","terms":["中共"],"cut":[false,false]},"hits":2,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/100/LCIDC01_11410004.pdf","printed_pages":"63-102"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/100/LCIDC01_11410004.pdf","printed_pages":"63-102"}]}],"defense":[{"person_id":"ly1281","year":2024,"event_id":"bill:202110034620000","activity":"bill_primary","title":"「陸海空軍軍官士官服役條例第三十九條條文修正草案」，請審議案。","meeting":"第11屆第1會期第11次會議","date":"2024-04-26","highlight":{"excerpt":"本院委員陳永康、楊瓊瓔、李彥秀、翁曉玲等20人，有鑑於政府有善盡照顧退休軍人晚年生活之責任與義務，現行「陸海空軍軍官士官服役條例」之規定，重新計算已依法審定之退伍軍人退休金，差額自施行日起十年內，分年平均調降至無差額止，致大幅減少已退伍軍人","terms":["軍人","空軍","軍官","士官","服役","退伍"],"cut":[false,true]},"hits":11,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110034620000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/11/LCEWA01_110111_00041.pdf","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"bill:202110031710000","activity":"bill_primary","title":"「軍事審判法第三十四條條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"」，造成現役軍人即使在戰時有違反陸海空軍刑法及普通刑法之罪時（兩罪競合），對於該現役軍人追訴，必須捨棄特別法之軍事審判程序，而依普通法地位之刑事訴訟程序追訴，除明顯違背「特別法優先原則」而形成法體系之混亂外，更造成軍事審判之特別目的無法達成","terms":["現役","軍人","空軍","軍事"],"cut":[false,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110031710000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00033.pdf","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"bill:202110186370000","activity":"bill_primary","title":"「陸海空軍軍官士官服役條例第三十四條條文修正草案」，請審議案。","meeting":"第11屆第4會期第18次會議","date":"2026-01-16","highlight":{"excerpt":"爰擬具「陸海空軍軍官士官服役條例第三十四條條文修正草案」，放寬陸海空軍退休軍士官停止領受退休俸或贍養金之規定限制，以利政府有效發揚人力優勢，增進公務效率。","terms":["空軍","軍官","士官","服役"],"cut":[false,false]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110186370000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/18/LCEWA01_110418_00224.pdf","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"bill:202110046470000","activity":"bill_primary","title":"「國軍退除役官兵輔導條例增訂第二十七條之二條文草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","highlight":{"excerpt":"本院委員翁曉玲、陳永康、廖偉翔、馬文君、陳玉珍、徐巧芯等18人，鑑於軍人肩負保家衛國之責，在役期間警戒、待命、留守、演訓，退役時仍負有子女教養及家庭經濟壓力，必須再就業，非公教人員生活安定可相比擬，應充分考量軍人服役特性，從優給予相關補助措","terms":["軍人","退役","服役"],"cut":[false,true]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110046470000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/12/LCEWA01_110312_00625.pdf","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"bill:202110186380000","activity":"bill_primary","title":"「軍人及其家屬優待條例第十九條條文修正草案」，請審議案。","meeting":"第11屆第4會期第18次會議","date":"2026-01-16","highlight":{"excerpt":"本院委員陳永康、賴士葆、蘇清泉、王鴻薇、林沛祥等18人，為展現對服役軍人的基本尊重與社會支持，並降低其休假及返鄉成本，爰擬具「軍人及其家屬優待條例第十九條條文修正草案」。","terms":["服役","軍人"],"cut":[false,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110186380000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/18/LCEWA01_110418_00223.pdf","printed_pages":null}]}],"education":[{"person_id":"ly1281","year":2024,"event_id":"bill:202110046470000","activity":"bill_primary","title":"「國軍退除役官兵輔導條例增訂第二十七條之二條文草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","highlight":{"excerpt":"而退除役官兵支領退休俸、贍養金及生活補助費者之子女教育補助，自一百零六年度第一學期起，排除上校階以上，改發中校以下人員，致產生上校退伍人員相對權益剝奪感。","terms":["教育"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110046470000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/12/LCEWA01_110312_00625.pdf","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"speech:9fc0a1aacd12537a","activity":"speech","title":"第11屆第1會期外交及國防委員會第25次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第25次全體委員會議","date":"2024-06-06","highlight":{"excerpt":"所以我的建言就是，我們的教育經費不只是投資人才，我們國防大學也有國際班，我們還有辦遠朋班，接受外國來臺的中、高階軍官提供教育，可是我們的預算就這麼一點點，我個人的建議就是逐年調整，5年內要跟中山大學、中央大學的這個水平來評比；最主要就是，我","terms":["教育","大學"],"cut":[false,true]},"hits":12,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/58/LCIDC01_1135801.pdf","printed_pages":"1-46"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/58/LCIDC01_1135801.pdf","printed_pages":"1-46"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:3d463eb0015c0012","activity":"speech","title":"第11屆第4會期外交及國防委員會第19次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第19次全體委員會議","date":"2025-12-01","highlight":{"excerpt":"現在我看到的一點是教育經費沒有增加，比例相對是小的，所有的東西到了……不只是國軍的基礎教育、指參教育，還包括戰略教育，碰到所有武器、作戰構想、新的構想、AI導入，學校的課程都還來不及跟上，因此要有特聘的老師，而不是用現階的軍職，部隊完了調個","terms":["教育","學校","老師"],"cut":[false,true]},"hits":7,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/102/LCIDC01_11410202.pdf","printed_pages":"71-134"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/166013","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"speech:ddef9987d076045b","activity":"speech","title":"第11屆第1會期外交及國防委員會第3次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第3次全體委員會議","date":"2024-03-07","highlight":{"excerpt":"我們做出一個建議，因為現在教育部有高等教育深耕計畫，2018年開始，當年我曾經去向蔣偉寧部長替國防醫學院爭取卓越教學經費，也就是說，這個額度我想我們就同步做，一方面建議國防部向教育部爭取，另外我們也可以在教育委員會提出這個需求。","terms":["教育部","教育","教學"],"cut":[false,false]},"hits":7,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/08/LCIDC01_1130801.pdf","printed_pages":"1-60"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/149474","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"speech:74b995392e69374c","activity":"speech","title":"第11屆第2會期外交及國防委員會第20次全體委員會議","meeting":"第11屆第2會期外交及國防委員會第20次全體委員會議","date":"2024-12-04","highlight":{"excerpt":"針對第68案，我給大家做個說明，關於我們的醫師人才培育，除了各公私立學校以外，因為現在所謂的高等教育深耕計畫，這裡面是可以爭取教育部的贊助，但是需要退輔會協助與教育部及衛福部溝通，強化深耕計畫的補助費，這樣子我們的醫療人才，不管公私立的，就","terms":["學校","教育","教育部"],"cut":[false,true]},"hits":6,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/02/LCIDC01_1140201.pdf","printed_pages":"249-442"}]}],"foreign_trade":[{"person_id":"ly1281","year":2025,"event_id":"speech:59fd883be8ac6b9c","activity":"speech","title":"第11屆第4會期外交及國防委員會第6次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第6次全體委員會議","date":"2025-10-20","highlight":{"excerpt":"提出一個意見，就是過去在第一條船時，台船跟它的供應商、供應鏈簽約的時候，都說拿到出口許可，但是通常出口許可有但書，這個出口許可不保證你15年，在過程中間這個供應商如果被其他的大廠商併購了，併購以後這家供應商的專案經理被換掉了，那麼大廠商依約","terms":["出口"],"cut":[true,true]},"hits":5,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/85/LCIDC01_1148501.pdf","printed_pages":"169-208"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/164353","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"speech:20117ffbf26f073b","activity":"speech","title":"第11屆第4會期外交及國防委員會第7次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第7次全體委員會議","date":"2025-10-22","highlight":{"excerpt":"因此對我們經貿談判代表，如果是純粹從關稅經貿，你看到他跟中共玩的兩手策略，對國際的情勢，他永遠保持有調節的空間，也就是在這種情況下，我們要有自己的一個tolerance底線、口袋，絕對不要一廂情願對他示好、通通掏出來，要有一個迴路、調整的空","terms":["經貿","關稅"],"cut":[false,true]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/86/LCIDC01_1148601.pdf","printed_pages":"289-332"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/86/LCIDC01_1148601.pdf","printed_pages":"289-332"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:ee6968a357a40af5","activity":"speech","title":"第11屆第3會期外交及國防委員會第22次全體委員會議","meeting":"第11屆第3會期外交及國防委員會第22次全體委員會議","date":"2025-07-16","highlight":{"excerpt":"各位看一下，前面是它對你友好，它會設立使館，協助加入國際組織、交換，到開始要平衡貿易赤字、關稅問題與外交商務談判，可以合併談懲罰性關稅，一路下去到退出巴黎氣候協定、地緣結盟分享，這裡面有將近20個item是可以前後調節的，所以你如果不能看到","terms":["貿易","關稅"],"cut":[false,true]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/67/LCIDC01_1146701.pdf","printed_pages":"1-50"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/163136","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"speech:f19680862c0c58cc","activity":"speech","title":null,"meeting":null,"date":"2025-07-10","highlight":{"excerpt":"我們最近聽到川普總統說對等關稅並不只是經濟的問題，它是跟國家安全有關，我們也看到我們的關稅談判代表成員裡面有國安局局長，這就表示我們也認同對等關稅是國安的問題，國家安全的問題並不只限於目前國安法的敘述。","terms":["關稅"],"cut":[false,false]},"hits":3,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/65/LCIDC01_1146501.pdf","printed_pages":"365-466"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/65/LCIDC01_1146501.pdf","printed_pages":"365-466"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:1f9516469fe5be5f","activity":"speech","title":"第11屆第4會期外交及國防委員會第22次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第22次全體委員會議","date":"2025-12-17","highlight":{"excerpt":"既然有DCS，為什麼不能夠由我們的貿易談判代表去抵銷我們對美國的貿易順差？","terms":["貿易"],"cut":[false,false]},"hits":2,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/115/03/LCIDC01_1150301.pdf","printed_pages":"257-320"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/115/03/LCIDC01_1150301.pdf","printed_pages":"257-320"}]}],"international":[{"person_id":"ly1281","year":2025,"event_id":"speech:b27c3961fabfa01b","activity":"speech","title":"第11屆第4會期外交及國防委員會第5次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第5次全體委員會議","date":"2025-10-16","highlight":{"excerpt":"最後我再提一個建議，有關聯合國2758號決議的內容，當然對方有不同的扭曲解釋，我也看過外交部整個對外的英文論述，我特別要強調一下，因為當初的投票結果勉強通過，數量多了，但是美國當時是支持我們的，可是在這個2758號裡面的用字是用restor","terms":["聯合國","外交","外交部"],"cut":[false,true]},"hits":7,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/84/LCIDC01_1148401.pdf","printed_pages":"1-40"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/84/LCIDC01_1148401.pdf","printed_pages":"1-40"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:9366fe1926c442ce","activity":"speech","title":"第11屆第3會期外交及國防委員會第14次全體委員會議","meeting":"第11屆第3會期外交及國防委員會第14次全體委員會議","date":"2025-05-15","highlight":{"excerpt":"好，沒有關係，我跟您在這邊提個建議，它這邊是用中國大陸恢復他在聯合國的合法地位，可是聯合國憲章是1945年6月26號在舊金山簽的，1945年10月24日聯合國日成立，簽署的是以中華民國，當時是外交部長宋子文簽的字，所以聯合國憲章裡面的簽署國","terms":["聯合國","外交","外交部"],"cut":[false,true]},"hits":7,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/50/LCIDC01_1145001.pdf","printed_pages":"207-254"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/161406","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"speech:1b8f6b992c79ddcc","activity":"speech","title":"第11屆第4會期外交及國防委員會第16次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第16次全體委員會議","date":"2025-11-20","highlight":{"excerpt":"我可以從一個數字來給你回報，我們的韓院長在這邊不到兩年的時間，因為我們外交部同仁的努力，他已經接待了超過四千餘位來訪的外賓，包括國會、學者、智庫，相對前面的游錫堃院長四年才三千多個，韓院長接見外賓的數字反映出我們外交部同仁努力的成果，但是顯","terms":["外交","外交部"],"cut":[false,true]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/99/LCIDC01_1149901.pdf","printed_pages":"57-116"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/165661","printed_pages":null}]},{"person_id":"ly1281","year":2025,"event_id":"speech:06aae2102ab2ebea","activity":"speech","title":"第11屆第4會期外交及國防委員會第9次全體委員會議","meeting":"第11屆第4會期外交及國防委員會第9次全體委員會議","date":"2025-10-29","highlight":{"excerpt":"的維權，報告指出中共軍艦、海警船在民主礁（中共稱黃岩島）……我這邊做個補充報告，外交部在2015年就提出抗議，就是黃岩島，內政部國土署發布圖的位置也是黃岩島，民主礁是馬總統任內，他把它sculpture、看成民主礁，太平島在2016年被南海","terms":["外交","外交部"],"cut":[true,true]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/89/LCIDC01_1148901.pdf","printed_pages":"245-278"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/89/LCIDC01_1148901.pdf","printed_pages":"245-278"}]},{"person_id":"ly1281","year":2025,"event_id":"speech:2d6a518ef94d3947","activity":"speech","title":"第11屆第3會期外交及國防委員會第25次全體委員會議","meeting":"第11屆第3會期外交及國防委員會第25次全體委員會議","date":"2025-08-14","highlight":{"excerpt":"至於加薩走廊失去電力、沒有醫療系統，基於人道精神，外交部不管是援助難民，或是協助以色列做這些資訊分享，尤其是對不分國籍的難民的援助，我想外交部扮演一個很重要的角色，將來要合作協助烏克蘭重建，我想電網的電力分配是我們互動學習的角色，以上的建議","terms":["外交","外交部"],"cut":[false,true]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/73/LCIDC01_1147301.pdf","printed_pages":"1-46"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/163475","printed_pages":null}]}],"technology":[{"person_id":"ly1281","year":2024,"event_id":"speech:52ad7ce6a95aff6e","activity":"speech","title":"第11屆第1會期外交及國防委員會第16次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第16次全體委員會議","date":"2024-05-01","highlight":{"excerpt":"在通訊設施，我們希望用網格化的網路，不是線型的，就是要交錯型的、矩陣型的，在這裡面，國防部和內政部用的是不同，我們國防部的是機動性車載式的中繼臺，內政部的通常是Wi-Fi的高塔，固定的，包括警消用的是同樣的，所以我們提醒政府要統籌規劃、精準","terms":["通訊","網路"],"cut":[false,true]},"hits":12,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/36/LCIDC01_1133601.pdf","printed_pages":"1-50"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/151919","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"speech:1b6350753ffc9be2","activity":"speech","title":"第11屆第2會期外交及國防委員會第6次全體委員會議","meeting":"第11屆第2會期外交及國防委員會第6次全體委員會議","date":"2024-10-21","highlight":{"excerpt":"此，根據部長提報的資料，右邊的這一塊我們做出一個流程，我們的定義是國家或地區對於AI及其相關資源的控制和管理能力，要建立這個能量，目標是爭取國家利益、維護社會倫理與確保全民福利，方法是針對AI系統開發、部署和應用，最主要是我們有法律規範，要","terms":["AI"],"cut":[true,true]},"hits":8,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/86/LCIDC01_1138601.pdf","printed_pages":"81-150"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/86/LCIDC01_1138601.pdf","printed_pages":"81-150"}]},{"person_id":"ly1281","year":2024,"event_id":"speech:6fed2b66467041a1","activity":"speech","title":"第11屆第1會期外交及國防委員會第26次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第26次全體委員會議","date":"2024-06-12","highlight":{"excerpt":"這次我們數發部做督導，中華電信做協作，就應變或戰時應用新興科技強化通訊網路數位韌性驗證計畫，我們是希望確保指揮體系在戰爭或是大規模災害發生的時候，能夠支援政府指揮調度體系正常運作，同時跟國際間保持通訊暢通。","terms":["數發部","電信","科技","通訊","網路","數位"],"cut":[false,false]},"hits":7,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/61/LCIDC01_1136101.pdf","printed_pages":"103-166"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/153808","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"speech:dae3834d102f8128","activity":"speech","title":"第11屆第2會期外交及國防委員會第7次全體委員會議","meeting":"第11屆第2會期外交及國防委員會第7次全體委員會議","date":"2024-10-23","highlight":{"excerpt":"西岸的基礎建設，因此海灘不容易變成兩棲登陸，美方的智庫就說，將來可能就是把我們的通訊斷纜；中華電信跟經濟部都能夠掌握發電、網路、配電，現在還有超高壓配電所的安維，這也是重要防護，所以海纜跟電信、衛星跟微波三個相互支援，必須要有一個整合計畫，","terms":["通訊","電信","網路","衛星"],"cut":[true,true]},"hits":6,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/87/LCIDC01_1138701.pdf","printed_pages":"271-352"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/87/LCIDC01_1138701.pdf","printed_pages":"271-352"}]},{"person_id":"ly1281","year":2024,"event_id":"speech:b8d80a004628e7b2","activity":"speech","title":"第11屆第1會期外交及國防委員會第33次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第33次全體委員會議","date":"2024-07-10","highlight":{"excerpt":"我這邊提出建議，包括所有的廠商都提出了，它提供你的是載台、載具、通訊頻道頻寬、傳輸速度，聯六通資次長室、資通電軍、數發部及NCC要去談我們的國軍能夠獲得多少頻寬、多少頻道，如果在戰時我們國內一般民間的通訊，比方講中華電信如果中斷了，誰來提供","terms":["通訊","資通","數發部","NCC","電信"],"cut":[false,true]},"hits":6,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/73/LCIDC01_1137301.pdf","printed_pages":"1-44"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/154634","printed_pages":null}]}],"unclassified":[{"person_id":"ly1281","year":2024,"event_id":"bill:202110061310000","activity":"bill_primary","title":"「國家安全戰略法草案」，請審議案。","meeting":"第11屆第1會期第22次會議","date":"2024-07-12","highlight":null,"hits":0,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110061310000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/22/LCEWA01_110122_00019.pdf","printed_pages":null}]},{"person_id":"ly1281","year":2024,"event_id":"bill:202110051640000","activity":"bill_primary","title":"「臺灣地區與大陸地區人民關係條例第二十九條條文修正草案」，請審議案。","meeting":"第11