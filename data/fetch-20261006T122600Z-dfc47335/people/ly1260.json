pdf/11/03/17/LCEWA01_110317_00171.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2024,"event_id":"bill:202110047810000","activity":"bill_primary","title":"「行政區劃法草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","highlight":{"excerpt":"符合實際生活圈及產業發展趨勢，俾提升地方治理品質與施政效能及建立公平合理之行政區劃程序，以因應未來推動行政區劃之迫切需求；復憲法第一百零八條第一項第二款規定將行政區劃事項之立法工作交由中央為之，為完成憲法委託事項，爰擬具「行政區劃法草案」。","terms":["憲法"],"cut":[true,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110047810000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/14/LCEWA01_110114_00066.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2024,"event_id":"bill:202110016990000","activity":"bill_primary","title":"「立法院職權行使法部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第6次會議","date":"2024-03-22","highlight":{"excerpt":"本院委員吳宗憲等16人，有鑑於大法官釋字第五八五號解釋揭示：「立法院為有效行使憲法所賦予之立法職權，本其固有之權能自得享有一定之調查權，主動獲取行使職權所需之相關資訊，俾能充分思辯，審慎決定，以善盡民意機關之職責，發揮權力分立與制衡之機能。","terms":["大法官","憲法"],"cut":[false,false]},"hits":2,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110016990000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/06/LCEWA01_110106_00072.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2025,"event_id":"bill:212110101360000","activity":"bill_primary","title":"擬具公投提案主文為：「您是否同意『各級法院合議庭法官判處死刑不須一致決』之政策？」請公決案。","meeting":"第11屆第3會期第6次會議","date":"2025-03-21","highlight":{"excerpt":"擬具公投提案主文為：「您是否同意『各級法院合議庭法官判處死刑不須一致決』之政策？","terms":["公投"],"cut":[false,false]},"hits":1,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/212110101360000/details","printed_pages":null}]}],"law_crime":[{"person_id":"ly1260","year":2025,"event_id":"bill:202110167220000","activity":"bill_primary","title":"「刑事訴訟法第四百零四條條文修正草案」，請審議案。","meeting":"第11屆第4會期第6次會議","date":"2025-10-28","highlight":{"excerpt":"本院委員吳宗憲、林沛祥等17人，為兼顧審判品質與人權保障，避免檢察官於起訴後對法院撤銷或停止羈押等裁定重複抗告，造成程序無限循環、壓縮承審法官的獨立審判權、實質侵蝕無罪推定原則，使被告長期處於人身自由遭剝奪之危懼不安狀態，戕害被告人權至鉅，","terms":["審判","檢察官","檢察","法院","羈押","法官"],"cut":[false,true]},"hits":20,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110167220000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/06/LCEWA01_110406_00080.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2025,"event_id":"bill:202110155110000","activity":"bill_primary","title":"「中華民國刑法部分條文修正草案」，請審議案。","meeting":"第11屆第3會期第24次會議","date":"2025-08-08","highlight":{"excerpt":"爰此，我國現行刑法主刑之種類，僅概括規範無期徒刑且逾二十五年即可申請假釋，與死刑之間刑度落差太大，就罪大惡極、泯滅人心之犯行，恐無法達到真正評價犯罪之目的，刑法之嚇阻作用亦將減損，為使無期徒刑、假釋制度能互相搭配，修法將無期徒刑分級，包含一","terms":["刑法","徒刑","假釋","死刑","犯罪"],"cut":[false,true]},"hits":20,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110155110000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/24/LCEWA01_110324_00009.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2025,"event_id":"bill:202110123930000","activity":"bill_primary","title":"「中華民國刑法部分條文修正草案」，請審議案。","meeting":"第11屆第3會期第11次會議","date":"2025-05-09","highlight":{"excerpt":"本院委員許宇甄、吳宗憲等18人，憲法法庭於113年9月20日作成憲判字第8號判決，藉由設定「犯罪情節屬最嚴重」及「最嚴密之正當法律程序要求」等條件，實務上大幅限縮法院依法宣告死刑之可能；在另一方面，在死刑適用日益嚴格的同時，作為死刑替代刑罰","terms":["判決","犯罪","法院","死刑"],"cut":[false,true]},"hits":16,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110123930000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/11/LCEWA01_110311_00050.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2024,"event_id":"bill:202110050100000","activity":"bill_primary","title":"「刑事訴訟法增訂部分條文草案」，請審議案。","meeting":"第11屆第1會期第15次會議","date":"2024-05-24","highlight":{"excerpt":"本院委員吳宗憲、張嘉郡、游顥、王鴻薇、黃建賓等20人，有鑑於我國最高法院接續指出偵查機關以全球衛星定位系統（GPS）、「M化偵查網路系統」（M化車）為追蹤位置及行動通訊設備位置之調查，亟待明文授權規範，為使偵查機關跟上數位科技時代，提升偵查","terms":["法院","偵查"],"cut":[false,true]},"hits":10,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110050100000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/15/LCEWA01_110115_00061.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2024,"event_id":"bill:202110078020000","activity":"bill_primary","title":"「中華民國刑法增訂第十章之一、第一百七十二條之一及第一百七十二條之二條文草案」，請審議案。","meeting":"第11屆第2會期第10次會議","date":"2024-11-22","highlight":{"excerpt":"、廖偉翔、牛煦庭、羅廷瑋、顏寬恒等19人，有鑑於「行賄證人」、「不法關說」等妨害司法公正之行為，不僅打擊司法威信，使司法正義無法伸張，更重創人民對於司法之信任度，惟我國現行法卻無相關罰則，實乃立法之重大疏漏，另為落實2017年司法改革國是會","terms":["司法","司法改革"],"cut":[true,true]},"hits":8,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110078020000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/02/10/LCEWA01_110210_00015.pdf","printed_pages":null}]}],"unclassified":[{"person_id":"ly1260","year":2025,"event_id":"bill:202110167190000","activity":"bill_primary","title":"「民法第一千二百二十三條條文修正草案」，請審議案。","meeting":"第11屆第4會期第6次會議","date":"2025-10-28","highlight":null,"hits":0,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110167190000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/06/LCEWA01_110406_00081.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2025,"event_id":"bill:202110167200000","activity":"bill_primary","title":"「民法繼承編施行法增訂第十二條條文草案」，請審議案。","meeting":"第11屆第4會期第6次會議","date":"2025-10-28","highlight":null,"hits":0,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110167200000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/06/LCEWA01_110406_00082.pdf","printed_pages":null}]},{"person_id":"ly1260","year":2024,"event_id":"bill:202110047800000","activity":"bill_primary","title":"「紀念日及節日實施條例草案」，請審議案。","meeting":"第11屆第1會期第14次會議","date":"2024-05-17","high