d":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/107/36/LCIDC01_1073601.pdf","printed_pages":"119-250"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/107/36/LCIDC01_1073601.pdf","printed_pages":"119-250"}]},{"person_id":"ly1169","year":2018,"event_id":"speech:894903c2877b0bba","activity":"speech","title":"第9屆第5會期內政委員會第14次全體委員會議","meeting":"第9屆第5會期內政委員會第14次全體委員會議","date":"2018-05-14","highlight":{"excerpt":"簡單地說，因為有人報案說有位非裔的美國男生疑似要打破窗戶，所以在黑暗中，這位警察看到有位非裔的美國男生後就開始追捕他，這名警察在黑暗中看到這名非裔的男生手上好像拿著一個東西，警察懷疑他拿的是手槍，但其實他是在自己家裡面的後院，但是警察在看不","terms":["警察"],"cut":[false,true]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/107/61/LCIDC01_1076101.pdf","printed_pages":"1-46"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/107/61/LCIDC01_1076101.pdf","printed_pages":"1-46"}]},{"person_id":"ly1169","year":2018,"event_id":"speech:3f207e3ff87fd083","activity":"speech","title":"第9屆第5會期內政委員會第12次全體委員會議","meeting":"第9屆第5會期內政委員會第12次全體委員會議","date":"2018-04-25","highlight":{"excerpt":"愛警察、關心警察不是說說而已，不是利用這樣的情況來討論一些政治議題、虛幻的議題，我們希望看到對警察人員實質的保障，不僅是身體方面的保障，免於恐懼被攻擊的保障，我們也希望在每月的薪資結構，甚至退休後的生活都可以讓警察獲得適度的保障。","terms":["警察"],"cut":[false,false]},"hits":4,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/107/46/LCIDC01_1074601.pdf","printed_pages":"221-276"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/107/46/LCIDC01_1074601.pdf","printed_pages":"221-276"}]}],"unclassified":[{"person_id":"ly1169","year":2017,"event_id":"bill:1060929070200400","activity":"bill_primary","title":"「廣播電視法第十七條及第三十六條條文修正草案」，請審議案。","meeting":"第9屆第4會期第4次會議","date":"2017-10-13","highlight":null,"hits":0,"links":[{"kind":"bill_page"