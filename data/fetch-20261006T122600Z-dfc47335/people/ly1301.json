ount":0,"bills":27},{"year":2025,"stage":"flow_unknown","as_of":"2026-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":27}],"records":{"health":[{"person_id":"ly1301","year":2025,"event_id":"bill:202110184080000","activity":"bill_primary","title":"「國家中醫研究院設置條例草案」，請審議案。","meeting":"第11屆第4會期第17次會議","date":"2026-01-09","highlight":{"excerpt":"本院委員王正旭、莊瑞雄等19人，鑑於擴增國家中醫藥研發能力，執行國家中醫藥政策及計畫，有效整合國內產、官、學、研資源，並促進產業發展，實有改制為行政法人之需要，以及時掌握國際脈絡趨勢之科學研究步調，更有效發揮組織效能，活絡延攬科學研究人才，","terms":["中醫","醫藥"],"cut":[false,true]},"hits":20,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110184080000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/17/LCEWA01_110417_00169.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2024,"event_id":"bill:202110031830000","activity":"bill_primary","title":"「再生醫療製劑條例草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"鑒於再生醫療製劑之成分異質性、製程特殊性及治療複雜性，風險管控有別於化學或生物製劑，現行藥事法相關規範無法完全涵蓋或一體適用，參酌國際間對再生醫療製劑之立法管理，為兼顧我國再生醫療產業發展趨勢，建構符合我國實務管理之架構，針對再生醫療製劑之","terms":["醫療","治療"],"cut":[false,true]},"hits":13,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110031830000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00046.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110178030000","activity":"bill_primary","title":"「藥事法部分條文修正草案」，請審議案。","meeting":"第11屆第4會期第13次會議","date":"2025-12-12","highlight":{"excerpt":"員王正旭、莊瑞雄、徐富癸等20人，有鑑於自嚴重特殊傳染性肺炎（COVID-19）疫情以來，全球政經情勢驟變，原料藥供給不穩，且藥品需求上揚，致國內外藥品供應時有緊張情事，中央衛生主管機關為求更為即時掌握必要藥品之供應，以及早提出相關因應措施","terms":["疫情","藥品"],"cut":[true,true]},"hits":11,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110178030000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/13/LCEWA01_110413_00145.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110184070000","activity":"bill_primary","title":"「國家醫療科技評估中心設置條例草案」，請審議案。","meeting":"第11屆第4會期第17次會議","date":"2026-01-09","highlight":{"excerpt":"本院委員王正旭、莊瑞雄等19人，鑑於隨著我國醫療科技評估業務範疇逐漸擴展，以及在新醫療科技評估上面臨許多挑戰，例如創新醫療科技之相對療效實證有限且價格昂貴，導致影響全民健康保險新藥收載速度及病友在相關治療取得之可近性等，為能擴大推動醫療科技","terms":["醫療","治療"],"cut":[false,true]},"hits":10,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110184070000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/17/LCEWA01_110417_00170.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2024,"event_id":"bill:202110031820000","activity":"bill_primary","title":"「再生醫療法草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"為確保再生醫療之品質、安全及有效性，維護病人接受治療之權益，對於再生醫療之執行，包括醫療機構得執行再生醫療之範疇、再生醫療組織細胞來源管理、人體試驗與研究及監督與預防等事項予以規範，俾供醫療機構及其他相關業者遵循，爰擬具「再生醫療法草案」。","terms":["醫療","病人","治療"],"cut":[false,false]},"hits":9,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110031820000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00045.pdf","printed_pages":null}]}],"labor":[{"person_id":"ly1301","year":2025,"event_id":"bill:202110105170000","activity":"bill_primary","title":"「工會法第六條之一及第七條條文修正草案」，請審議案。","meeting":"第11屆第3會期第8次會議","date":"2025-04-18","highlight":{"excerpt":"本院委員王正旭等19人，有鑑於憲法法庭一百十二年憲判字第七號判決，以《工會法》施行細則第二條第一項及第二項有關《工會法》第六條第一項第一款「廠場」之相關規定，涉及勞工得組成廠場工會之要件，屬限制勞工結社權之重要事項，而未經《工會法》明確授權","terms":["工會","勞工"],"cut":[false,true]},"hits":6,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110105170000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/03/08/LCEWA01_110308_00076.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110173190000","activity":"bill_primary","title":"「外送員權益保障及外送平臺管理法草案」，請審議案。","meeting":"第11屆第4會期第9次會議","date":"2025-11-14","highlight":{"excerpt":"者彼此權利義務關係愈趨複雜，非現行法律能為外送平臺之適當管理，尤其外送員已成新興勞動型態，惟長期處於法律保障不足之狀態，勞動條件、報酬透明、職業安全、平臺演算法管理等規範均亟待完善，為建立外送員之權益保障體系，確保其在具彈性之工作模式中，同","terms":["勞動","職業安全"],"cut":[true,true]},"hits":5,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110173190000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/09/LCEWA01_110409_00191.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110175590000","activity":"bill_primary","title":"「勞工保險條例第六十六條及第六十九條條文修正草案」，請審議案。","meeting":"第11屆第4會期第11次會議","date":"2025-11-28","highlight":{"excerpt":"考量勞工保險為國家辦理之社會保險制度，為維持勞工保險基金流量，政府自2020年起編列公務預算撥補勞工保險基金，並在搭配多元投資運用下，勞工保險基金2024年6月首度達上兆規模並持續至今，顯示政府撥補對協助穩定基金流量有正面助益。","terms":["勞工"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110175590000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/11/LCEWA01_110411_00084.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110162770000","activity":"bill_primary","title":"「職業安全衛生法部分條文修正草案」，請審議案。","meeting":"第11屆第4會期第4次會議","date":"2025-10-14","highlight":{"excerpt":"又因應近期社會發生數起職場霸凌事件，引發社會關注職場霸凌防治法制不足議題，現行本法以預防職場不法侵害為重點，勞動檢查不涉及個案調查認定，對於最高負責人如為行為人，欠缺外部申訴、調查機制及對行為人之處分等疑慮。","terms":["職場","勞動"],"cut":[false,false]},"hits":4,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110162770000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/04/LCEWA01_110404_00017.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110175580000","activity":"bill_primary","title":"「就業服務法第二十四條條文修正草案」，請審議案。","meeting":"第11屆第4會期第11次會議","date":"2025-11-28","highlight":{"excerpt":"008年迄今業經17年，加上我國政策目前仍考量新住民就業需面臨語言、文化差異所生之職場適應問題，且其需求不因是否歸化、取得戶籍而有差異，為保障及擴大照顧已歸化之新住民就業權益，勞動部更於2025年8月修正要點擴大納入已歸化、設籍後之新住民。","terms":["職場","勞動部","勞動"],"cut":[true,false]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110175580000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/11/LCEWA01_110411_00083.pdf","printed_pages":null}]}],"social_welfare":[{"person_id":"ly1301","year":2025,"event_id":"bill:202110186750000","activity":"bill_primary","title":"「人工生殖法修正草案」，請審議案。","meeting":"第11屆第4會期第18次會議","date":"2026-01-16","highlight":{"excerpt":"社會風俗、性別觀念、社會風氣隨著時代不斷變遷，且科技發展日新月異，社會對於婚姻與生育已逐漸擁有不同的想像，例如：《司法院釋字第七四八號解釋施行法》賦予相同性別之二人得成立具有親密性、排他性之永久結合關係，並向戶政機關辦理結婚登記，以及婦女生","terms":["生育"],"cut":[true,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110186750000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/18/LCEWA01_110418_00243.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110184030000","activity":"bill_primary","title":"「衛生福利部組織法第二條、第五條及第八條條文修正草案」，請審議案。","meeting":"第11屆第4會期第17次會議","date":"2026-01-09","highlight":{"excerpt":"委員王正旭、莊瑞雄等19人，有鑑於我國人口結構持續變化並已邁入超高齡社會，惟現行長照業務分散於衛生福利部各掌理護理及社會福利等機關，影響政策執行效能，爰擬將業務整併；另鑑於臺灣少子女化情況日益嚴重，更須強化兒童及少年之健康促進、福利及權益保","terms":["長照","社會福利"],"cut":[true,true]},"hits":3,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110184030000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/04/17/LCEWA01_110417_00173.pdf","printed_pages":null}]},{"person_id":"ly1301","year":2025,"event_id":"bill:202110155850000","activity":"bill_primary","title":"「所得稅法第十七條條文修正草案」，請審議案。","meeting":"第11屆第3會期第26次會議","date":"2025-08-22","highlight":{"excerpt":"國目前高齡化及少子女化之人口發展趨勢，導致國人整體長期照護需求及負擔增加，為降低長照家屬的經濟負擔，強化政府對有長照需求之國人及其家屬之政策協助，爰擬具「所得稅法第十七條條文修正草案」，將現行所得稅法中針對長期照護之特別扣除額度，由現行12","terms":["長照"],"cut":[true,true]},"hits":2,"links":[{"kind":"bil