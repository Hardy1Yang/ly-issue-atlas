of":"2026-01-31","as_of_count":0,"eventual_count":0,"undated_count":0,"bills":29}],"records":{"defense":[{"person_id":"ly1264","year":2024,"event_id":"bill:202110033360000","activity":"bill_primary","title":"「陸海空軍軍官士官服役條例部分條文修正草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"、林宜瑾、林楚茵、蔡易餘等17人，為維護國家主權及自由民主憲政秩序，爰擬具「陸海空軍軍官士官服役條例部分條文修正草案」，明定軍官、士官犯內亂罪、外患罪，經判刑確定，或犯國家安全法、陸海空軍刑法違反效忠國家職責罪章、國家機密保護法、國家情報工","terms":["空軍","軍官","士官","服役"],"cut":[true,true]},"hits":7,"links":[{"kind":"bill_page","url":"https://ppg.ly.gov.tw/ppg/bills/202110033360000/details","printed_pages":null},{"kind":"bill_doc","url":"https://ppg.ly.gov.tw/ppg/download/agenda1/02/pdf/11/01/10/LCEWA01_110110_00089.pdf","printed_pages":null}]},{"person_id":"ly1264","year":2025,"event_id":"speech:747745cd7af60a63","activity":"speech","title":"第11屆第3會期外交及國防委員會第8次全體委員會議","meeting":"第11屆第3會期外交及國防委員會第8次全體委員會議","date":"2025-04-16","highlight":{"excerpt":"有兩件事情我想要問，第一個就是過往發現現役軍人的接觸很多是透過退役軍官，這是我們確定的事情，這個我在質詢退輔會、國防部的時候很常提到，而這幾天剛有好五星旗的新聞，我們發現中間人一開始並不是退役軍官，而是宗教組織，也就是先從宗教組織，再到退役","terms":["現役","軍人","退役","軍官","退輔會","國防","國防部"],"cut":[false,true]},"hits":13,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/37/LCIDC01_1143702.pdf","printed_pages":"235-272"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/114/37/LCIDC01_1143702.pdf","printed_pages":"235-272"}]},{"person_id":"ly1264","year":2024,"event_id":"speech:abe525aa66f2a45d","activity":"speech","title":"第11屆第1會期外交及國防委員會第33次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第33次全體委員會議","date":"2024-07-10","highlight":{"excerpt":"根據剛剛部長的回答請教，關於中科院的角色，左邊這個第三條是說中科院的業務範圍，裡面包含生產、製造、銷售、國內外的交流等等之類的，我在前任邱部長的時候有提過一件事情，中科院會負責生產、製造及銷售，但因為中科院的董事長是國防部長來兼任，今天如果","terms":["中科院","國防","國防部"],"cut":[false,true]},"hits":11,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/73/LCIDC01_1137301.pdf","printed_pages":"1-44"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/73/LCIDC01_1137301.pdf","printed_pages":"1-44"}]},{"person_id":"ly1264","year":2024,"event_id":"speech:f757049bb4ed4ff3","activity":"speech","title":"第11屆第1會期外交及國防委員會第3次全體委員會議","meeting":"第11屆第1會期外交及國防委員會第3次全體委員會議","date":"2024-03-07","highlight":{"excerpt":"部長你好，我今天最主要想問關於灰色地帶作戰的應處，第一件事情，的確我們在過往的一些文獻還有國防部的一些說法裡面不斷提到灰色地帶作戰，這次在業務報告裡面也看到灰色地帶作戰為了因應漢光演習而有所延長，先問第一件事情，從國軍、國防部開始提出灰色地","terms":["作戰","國防","國防部","演習","國軍"],"cut":[false,true]},"hits":11,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/08/LCIDC01_1130801.pdf","printed_pages":"1-60"},{"kind":"ivod","url":"https://ivod.ly.gov.tw/Play/Clip/1M/149461","printed_pages":null}]},{"person_id":"ly1264","year":2024,"event_id":"speech:d011f5ab061cf554","activity":"speech","title":"第11屆第2會期外交及國防委員會第16次全體委員會議","meeting":"第11屆第2會期外交及國防委員會第16次全體委員會議","date":"2024-11-21","highlight":{"excerpt":"之前跟退輔會在談的時候，退輔會會覺得說我們是一個發放的機關，很多事情是國防部在決定，那這件事情確實在最下面這一段的喪失權益部分，我認為在喪失權益的部分，國防部大概是有一個比較大的say，就是基本上是國防部在做決定，退輔會這邊只是配合。","terms":["退輔會","國防","國防部"],"cut":[false,false]},"hits":9,"links":[{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/104/LCIDC01_11310401.pdf","printed_pages":"129-168"},{"kind":"gazette_pdf","url":"https://ppg.ly.gov.tw/ppg/PublicationBulletinDetail/download/communique1/final/pdf/113/104/LCIDC01_11310401.pdf","printed_pages":"129-168"}]}],"government":[{"person_id":"ly1264","year":2024,"event_id":"bill:202110033370000","activity":"bill_primary","title":"「中華民國刑法增訂第一百二十二條之一條文草案」，請審議案。","meeting":"第11屆第1會期第10次會議","date":"2024-04-19","highlight":{"excerpt":"楚茵、蔡易餘等17人，鑑於我國現行刑事法制中，尚無處罰中間人「收受報酬而遊說主管公務員」的獨立罪，為確保國家機關得以依法公正執行職務之法益受到保護，爰參考奧地利1964年修訂之刑法第三百零八條及日本刑法第一百九十七條之四立法例，擬具「中華民","terms":["公務員"],"cut":[true,true]},"hits"